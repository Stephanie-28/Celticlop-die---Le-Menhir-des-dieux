<article class="flex h-full flex-col overflow-hidden rounded-2xl bg-white shadow-[0_8px_24px_rgba(52,87,109,0.1)]">
    <div class="relative aspect-[2/3] w-full overflow-hidden rounded-t-2xl">
        <img
            src="{{ asset(image) }}"
            alt="{{ alt }}"
            class="h-full w-full object-contain object-center"
        >
    </div>

    <div class="flex flex-1 flex-col px-5 py-4">
        <h3 class="font-mythic text-lg leading-tight text-celestial-800">{{ title }}</h3>
        <p class="mt-1 text-xs leading-5 text-celestial-600">{{ subtitle }}</p>
        <p class="mt-3 line-clamp-4 text-sm leading-6 text-slate-600">{{ description }}</p>

        {% if buttonText and buttonUrl %}
            <a href="{{ buttonUrl }}" class="mt-4 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-celestial-600 px-4 py-3 text-sm font-semibold text-white shadow-sm transition duration-200 hover:-translate-y-0.5 hover:bg-celestial-800 hover:shadow-md">
                {{ buttonText }}
                <span aria-hidden="true">→</span>
            </a>
        {% endif %}
    </div>
</article>
