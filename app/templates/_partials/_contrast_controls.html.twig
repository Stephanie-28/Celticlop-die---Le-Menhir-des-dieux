<div class="mt-4 rounded-xl bg-[#f2f6f7] p-4" aria-labelledby="contrast-controls-title">
    <p id="contrast-controls-title" class="text-sm font-semibold text-celestial-800">Contraste de l’affichage</p>
    <div class="mt-3 flex flex-wrap gap-2" role="group" aria-label="Choisir le niveau de contraste">
        <button type="button" data-contrast-mode="standard" class="min-h-11 rounded-lg border border-celestial-800/30 bg-white px-4 text-sm font-semibold text-celestial-800 focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-celestial-800">Contraste standard</button>
        <button type="button" data-contrast-mode="high" class="min-h-11 rounded-lg border-2 border-[#102f28] bg-[#102f28] px-4 text-sm font-semibold text-white focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-[#102f28]">Contraste renforcé</button>
    </div>
    <p class="mt-3 text-xs text-slate-600" aria-live="polite" data-contrast-status>Contraste actuel : standard</p>
</div>
