<header class="border-b border-slate-200 bg-white font-editorial" aria-label="En-tête principal">
    <div class="mx-auto flex h-14 max-w-6xl items-center px-4">
        <a href="/" class="flex min-w-0 items-center gap-2">
            <span class="inline-flex size-8 shrink-0 items-center justify-center rounded-full border border-mythic-gold/50 bg-celestial-800 text-sm text-mythic-gold" aria-hidden="true">✦</span>
            <span class="truncate font-mythic text-[13px] text-celestial-800 sm:text-base">Le Menhir des Dieux</span>
        </a>

        <div class="ml-auto flex items-center text-xs text-celestial-800">
            {% if app.user %}
                <span class="max-w-32 truncate font-semibold">{{ app.user.pseudo }}</span>
                <span aria-hidden="true" class="mx-2 text-slate-300">/</span>
                <a href="/deconnexion" class="text-mythic-gold">Déconnexion</a>
            {% else %}
                <a href="/connexion" class="text-mythic-gold">Connexion</a>
            {% endif %}
        </div>
    </div>
</header>
