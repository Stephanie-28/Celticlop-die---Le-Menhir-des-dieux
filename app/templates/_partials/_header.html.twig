<header class="border-b border-slate-200 bg-white font-editorial" aria-label="En-tête principal">
    <div class="mx-auto flex h-14 max-w-6xl items-center px-4">
        <a href="{{ path('app_home') }}" class="flex min-w-0 items-center gap-2">
            <span class="inline-flex size-8 shrink-0 items-center justify-center rounded-full border border-mythic-gold/50 bg-celestial-800 text-sm text-mythic-gold" aria-hidden="true">✦</span>
            <span class="truncate font-mythic text-[13px] text-celestial-800 sm:text-base">Le Menhir des Dieux</span>
        </a>

        <div class="ml-auto flex shrink-0 items-center gap-2 text-xs text-celestial-800 sm:gap-3">
            {% if app.user %}
                <a href="{{ path('app_profile') }}" class="flex size-9 items-center justify-center overflow-hidden rounded-full border-2 border-mythic-gold bg-[#e7dfca] shadow-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-celestial-800" aria-label="Voir le profil de {{ app.user.pseudo }}">
                    {% if app.user.avatar %}
                        <img src="{{ asset('uploads/avatars/' ~ app.user.avatar) }}" alt="Avatar de {{ app.user.pseudo }}" class="size-full object-cover">
                    {% else %}
                        <span class="font-mythic text-sm text-[#173d34]" aria-hidden="true">{{ app.user.pseudo|first|upper }}</span>
                    {% endif %}
                </a>
            {% else %}
                <a href="{{ path('app_login') }}" class="rounded-full px-2 py-2 text-celestial-800 transition hover:text-mythic-gold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-celestial-800 sm:px-3">Se connecter</a>
                <a href="{{ path('app_register') }}" class="rounded-full border border-mythic-gold/60 px-3 py-2 font-semibold text-mythic-gold transition hover:bg-[#fffaf0] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-celestial-800 sm:px-4">S’inscrire</a>
            {% endif %}
        </div>
    </div>
</header>
