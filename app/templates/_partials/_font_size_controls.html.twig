<div class="mt-5 rounded-xl bg-[#f2f6f7] p-4" aria-labelledby="font-size-controls-title">
    <p id="font-size-controls-title" class="text-sm font-semibold text-celestial-800">Taille du texte</p>
    <div class="mt-3 flex flex-wrap items-center gap-2">
        <button type="button" data-font-action="decrease" class="flex min-h-11 min-w-11 items-center justify-center rounded-lg border border-celestial-800/30 bg-white px-3 font-semibold text-celestial-800 hover:bg-[#e5f0f2] focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-celestial-800" aria-label="Réduire la taille du texte">A−</button>
        <button type="button" data-font-action="reset" class="min-h-11 rounded-lg border border-celestial-800/30 bg-white px-4 text-sm font-semibold text-celestial-800 hover:bg-[#e5f0f2] focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-celestial-800">Taille normale</button>
        <button type="button" data-font-action="increase" class="flex min-h-11 min-w-11 items-center justify-center rounded-lg border border-celestial-800/30 bg-white px-3 text-lg font-semibold text-celestial-800 hover:bg-[#e5f0f2] focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-celestial-800" aria-label="Agrandir la taille du texte">A+</button>
    </div>
    <p class="mt-3 text-xs text-slate-600" aria-live="polite" data-font-status>Taille actuelle : 100 %</p>
</div>
