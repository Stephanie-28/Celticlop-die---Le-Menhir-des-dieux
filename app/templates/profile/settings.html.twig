{% extends 'public/content/_layout.html.twig' %}

{% block title %}Paramètres du clan — Le Menhir des Dieux{% endblock %}

{% block content %}
    <header class="text-center">
        <p class="text-[10px] uppercase tracking-[0.28em] text-mythic-gold">Le Sanctuaire</p>
        <h1 class="mt-2 font-mythic text-3xl text-celestial-800 sm:text-5xl">Paramètres du clan</h1>
        <p class="mx-auto mt-4 max-w-2xl text-sm leading-7 text-slate-600">Consulte tes droits numériques et maîtrise les traces laissées au sein du Menhir.</p>
    </header>

    {% for message in app.flashes('settings_error') %}
        <div class="mx-auto mt-7 max-w-3xl rounded-2xl border border-red-200 bg-red-50 px-5 py-4 text-sm text-red-800" role="alert">{{ message }}</div>
    {% endfor %}

    <div class="mx-auto mt-9 grid max-w-3xl gap-5 sm:grid-cols-2">
        <a href="{{ path('app_public_accessibility') }}" class="rounded-2xl border border-mythic-gold/25 bg-white p-6 shadow-sm transition hover:border-mythic-gold/60 hover:shadow-md">
            <h2 class="font-mythic text-lg text-celestial-800">Accessibilité (RGAA)</h2>
            <p class="mt-2 text-sm leading-6 text-slate-600">Consulter l’état d’accessibilité, les limites connues et les moyens de signaler un obstacle.</p>
            <span class="mt-4 inline-flex text-sm font-semibold text-[#8a6a18]">Ouvrir la déclaration →</span>
        </a>
        <a href="{{ path('app_public_privacy') }}" class="rounded-2xl border border-mythic-gold/25 bg-white p-6 shadow-sm transition hover:border-mythic-gold/60 hover:shadow-md">
            <h2 class="font-mythic text-lg text-celestial-800">Confidentialité (RGPD)</h2>
            <p class="mt-2 text-sm leading-6 text-slate-600">Comprendre quelles données sont utilisées et connaître tes droits d’accès, de rectification et d’effacement.</p>
            <span class="mt-4 inline-flex text-sm font-semibold text-[#8a6a18]">Lire la politique →</span>
        </a>
    </div>

    <section class="mx-auto mt-8 max-w-3xl rounded-2xl border border-red-200 bg-white p-6 shadow-sm sm:p-8" aria-labelledby="delete-account-title">
        <p class="text-[10px] uppercase tracking-[0.22em] text-red-600">Zone irréversible</p>
        <h2 id="delete-account-title" class="mt-2 font-mythic text-xl text-red-800">Supprimer mon compte</h2>
        <p class="mt-3 text-sm leading-7 text-slate-600">Cette action supprime définitivement ton profil, ton avatar, tes favoris et ton historique de quiz.</p>
        <details class="mt-5">
            <summary class="inline-flex cursor-pointer rounded-xl border border-red-300 px-5 py-3 text-sm font-semibold text-red-700 hover:bg-red-50">Commencer la suppression</summary>
            <form action="{{ path('app_profile_delete_account') }}" method="post" class="mt-5 space-y-4 rounded-xl bg-red-50 p-5">
                <input type="hidden" name="_token" value="{{ csrf_token('delete-account') }}">
                <div><label for="delete-confirmation" class="block text-sm font-semibold text-red-900">Écris SUPPRIMER pour confirmer</label><input id="delete-confirmation" name="confirmation" required autocomplete="off" pattern="SUPPRIMER" class="mt-2 w-full rounded-xl border border-red-200 bg-white px-4 py-3"></div>
                <div><label for="delete-password" class="block text-sm font-semibold text-red-900">Mot de passe actuel</label><input id="delete-password" type="password" name="password" required autocomplete="current-password" class="mt-2 w-full rounded-xl border border-red-200 bg-white px-4 py-3"></div>
                <button type="submit" class="rounded-xl bg-red-700 px-5 py-3 text-sm font-semibold text-white">Supprimer définitivement mon compte</button>
            </form>
        </details>
    </section>

    <div class="mt-8 text-center"><a href="{{ path('app_profile') }}" class="text-sm font-semibold text-[#8a6a18]">← Retour au profil</a></div>
{% endblock %}
