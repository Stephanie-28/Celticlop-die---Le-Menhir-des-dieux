{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Metamorphous&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <style type="text/tailwindcss">
        @theme {
            --font-mythic: "Metamorphous", serif;
            --font-editorial: "Lora", serif;
            --color-celestial-50: #f3f8fc;
            --color-celestial-100: #e7f1f8;
            --color-celestial-600: #4f7890;
            --color-celestial-800: #34576d;
            --color-mythic-gold: #d3aa32;
        }

        .auth-field:-webkit-autofill,
        .auth-field:-webkit-autofill:hover,
        .auth-field:-webkit-autofill:focus {
            -webkit-box-shadow: 0 0 0 1000px #fff inset;
            -webkit-text-fill-color: #34576d;
            transition: background-color 9999s ease-out;
        }

        .auth-form {
            @apply space-y-8;
        }

        .auth-label {
            @apply mb-4 flex items-center gap-3 text-[15px] text-[#b77b13];
        }

        .auth-label-icon {
            @apply size-5 shrink-0 text-slate-600;
        }

        .auth-field {
            @apply w-full border-0 border-b border-[#e8bd62]/60 bg-white px-3 py-3 text-sm text-celestial-800 outline-none transition focus:border-mythic-gold focus:ring-0;
        }

        .auth-submit {
            @apply w-full rounded-xl bg-gradient-to-r from-[#21639a] to-[#88c6ec] px-5 py-5 text-[17px] text-white shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-md;
        }
    </style>
{% endblock %}

{% block body %}
    <main class="min-h-screen overflow-hidden bg-[#fefefe] px-5 pt-10 font-editorial text-celestial-800 sm:pt-14">
        <div class="mx-auto w-full max-w-[390px]">
            <a href="{{ path('app_home') }}" class="mx-auto block size-36 overflow-hidden rounded-lg sm:size-40">
                <img src="{{ asset('images/logo-menhir-officiel.png') }}" alt="Le Menhir des Dieux" class="size-full object-contain object-center">
            </a>

            <header class="relative mt-7 min-h-[280px] text-center">
                <img src="{{ asset('images/ui/auth-moon.svg') }}" alt="" aria-hidden="true" class="pointer-events-none absolute -left-3 top-14 h-[132px] w-[106px] opacity-80">
                <span aria-hidden="true" class="absolute left-0 top-6 text-base text-mythic-gold/45">✦</span>
                <span aria-hidden="true" class="absolute left-9 top-1 text-[10px] text-mythic-gold/45">✦</span>

                <h1 class="font-mythic text-[38px] uppercase leading-[1.65] text-[#b77b13]">
                    {% block auth_title %}{% endblock %}
                </h1>
                <p class="mt-3 text-sm uppercase tracking-[0.04em] text-[#174f7d]">Mode Céleste</p>
                <div aria-hidden="true" class="mx-auto mt-4 flex w-24 items-center gap-2 text-mythic-gold">
                    <span class="h-px flex-1 bg-mythic-gold/65"></span>
                    <span class="text-sm">✦</span>
                    <span class="h-px flex-1 bg-mythic-gold/65"></span>
                </div>
                <div class="mt-5 text-[18px] leading-8 text-[#174f7d]">
                    {% block auth_intro %}{% endblock %}
                </div>
            </header>

            <section class="mt-5 rounded-[22px] border border-[#e8bd62]/70 bg-white px-7 py-10 shadow-[0_14px_35px_rgba(52,87,109,0.07)] sm:px-8">
                {% block auth_form %}{% endblock %}
            </section>

            <div class="mt-14 text-center text-[15px] leading-6 text-[#174f7d]">
                {% block auth_footer %}{% endblock %}
            </div>

            <div class="relative mt-14 h-48" aria-hidden="true">
                <img src="{{ asset('images/ui/auth-cloud.svg') }}" alt="" class="absolute bottom-0 right-[-38px] w-[290px] opacity-75">
            </div>

            <div aria-hidden="true" class="flex items-center gap-3 pb-10">
                <span class="h-px flex-1 bg-sky-500"></span>
                <span class="text-base text-mythic-gold">✦</span>
                <span class="h-px flex-1 bg-sky-500"></span>
            </div>
        </div>
    </main>
{% endblock %}

{% block javascripts %}
    <script>
        document.addEventListener('click', (event) => {
            const button = event.target.closest('[data-password-toggle]');
            if (!button) {
                return;
            }

            const input = document.getElementById(button.dataset.passwordToggle);
            if (!input) {
                return;
            }

            input.type = input.type === 'password' ? 'text' : 'password';
            button.setAttribute('aria-pressed', input.type === 'text' ? 'true' : 'false');
        });
    </script>
{% endblock %}
