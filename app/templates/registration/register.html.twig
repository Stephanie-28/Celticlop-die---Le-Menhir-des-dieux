{% extends 'auth_base.html.twig' %}

{% block title %}Inscription — Le Menhir des Dieux{% endblock %}

{% block auth_title %}Inscription<br>au Clan{% endblock %}

{% block auth_intro %}Rejoignez le sanctuaire<br>des Druides et des Dieux.{% endblock %}

{% block auth_form %}
    {{ form_start(registrationForm, {attr: {class: 'auth-form'}}) }}
        {% if not registrationForm.vars.valid %}
            <div class="rounded-xl bg-red-50 px-4 py-3 text-sm text-red-700" role="alert">
                {{ form_errors(registrationForm) }}
            </div>
        {% endif %}

        <div>
            <div class="auth-label"><svg aria-hidden="true" viewBox="0 0 24 24" class="auth-label-icon fill-current"><circle cx="12" cy="7.5" r="4"/><path d="M5.5 21v-3.3A6.5 6.5 0 0 1 12 11.2a6.5 6.5 0 0 1 6.5 6.5V21Z"/></svg>{{ form_label(registrationForm.pseudo) }}</div>
            {{ form_widget(registrationForm.pseudo, {attr: {autocomplete: 'nickname', placeholder: 'Entrez votre nom sacré', class: 'auth-field'}}) }}
            <div class="mt-1 text-xs text-red-700">{{ form_errors(registrationForm.pseudo) }}</div>
        </div>

        <div>
            <div class="auth-label"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="auth-label-icon"><rect x="3" y="5.5" width="18" height="13" rx="1.5" stroke="currentColor" stroke-width="1.6"/><path d="m4 7 8 6 8-6" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>{{ form_label(registrationForm.email) }}</div>
            {{ form_widget(registrationForm.email, {attr: {autocomplete: 'email', placeholder: 'votre@esprit.com', class: 'auth-field'}}) }}
            <div class="mt-1 text-xs text-red-700">{{ form_errors(registrationForm.email) }}</div>
        </div>

        <div>
            <div class="auth-label"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="auth-label-icon"><rect x="5.5" y="10" width="13" height="11" rx="1.5" stroke="currentColor" stroke-width="1.7"/><path d="M8.5 10V7a3.5 3.5 0 0 1 7 0v3M12 14.5v3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>{{ form_label(registrationForm.plainPassword.first) }}</div>
            <div class="relative">
                {{ form_widget(registrationForm.plainPassword.first, {attr: {autocomplete: 'new-password', class: 'auth-field pr-11'}}) }}
                <button type="button" data-password-toggle="registration_form_plainPassword_first" aria-label="Afficher ou masquer le mot de passe" aria-pressed="false" class="absolute inset-y-0 right-0 flex w-10 items-center justify-center text-slate-500">
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="size-4" xmlns="http://www.w3.org/2000/svg"><path d="M3.5 12S6.5 7 12 7S20.5 12 20.5 12S17.5 17 12 17S3.5 12 3.5 12Z" stroke="currentColor" stroke-width="1.4"/><circle cx="12" cy="12" r="2.25" stroke="currentColor" stroke-width="1.4"/></svg>
                </button>
            </div>
            <div class="mt-1 text-xs text-red-700">{{ form_errors(registrationForm.plainPassword.first) }}</div>
        </div>

        <div>
            <div class="auth-label"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="auth-label-icon"><rect x="5.5" y="10" width="13" height="11" rx="1.5" stroke="currentColor" stroke-width="1.7"/><path d="M8.5 10V7a3.5 3.5 0 0 1 7 0v3M12 14.5v3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>{{ form_label(registrationForm.plainPassword.second, 'Confirmation du Sceau') }}</div>
            <div class="relative">
                {{ form_widget(registrationForm.plainPassword.second, {attr: {autocomplete: 'new-password', class: 'auth-field pr-11'}}) }}
                <button type="button" data-password-toggle="registration_form_plainPassword_second" aria-label="Afficher ou masquer la confirmation" aria-pressed="false" class="absolute inset-y-0 right-0 flex w-10 items-center justify-center text-slate-500">
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="size-4" xmlns="http://www.w3.org/2000/svg"><path d="M3.5 12S6.5 7 12 7S20.5 12 20.5 12S17.5 17 12 17S3.5 12 3.5 12Z" stroke="currentColor" stroke-width="1.4"/><circle cx="12" cy="12" r="2.25" stroke="currentColor" stroke-width="1.4"/></svg>
                </button>
            </div>
            <div class="mt-1 text-xs text-red-700">{{ form_errors(registrationForm.plainPassword.second) }}</div>
        </div>

        <div class="flex items-start gap-3">
            {{ form_widget(registrationForm.agreeTerms, {attr: {class: 'mt-1 size-4 shrink-0 rounded border-celestial-600/40 text-celestial-600 accent-[#4f7890]'}}) }}
            <div>
                {{ form_label(registrationForm.agreeTerms, null, {label_attr: {class: 'text-[15px] leading-7 text-[#174f7d]'}}) }}
                <div class="mt-1 text-xs text-red-700">{{ form_errors(registrationForm.agreeTerms) }}</div>
            </div>
        </div>

        <button type="submit" class="auth-submit">
            Entrer dans le Clan&nbsp; ✦
        </button>
    {{ form_end(registrationForm) }}
{% endblock %}

{% block auth_footer %}
    <a href="{{ path('app_login') }}" class="inline-block cursor-pointer text-[#174f7d] transition hover:text-celestial-600">
        Déjà initié ? Bon retour au Clan !
    </a>
{% endblock %}
