{% extends 'public/content/_layout.html.twig' %}
{% block title %}Bibliothèque musicale — Le Menhir des Dieux{% endblock %}
{% block content %}
    {% include 'music/_flashes.html.twig' %}
    <header class="text-center">
        <p class="text-[10px] uppercase tracking-[0.3em] text-mythic-gold">Échos du monde celtique</p>
        <h1 class="mt-3 font-mythic text-3xl text-forest-900 sm:text-5xl">Bibliothèque musicale</h1>
        <p class="mx-auto mt-4 max-w-2xl text-sm leading-7 text-slate-600">Écoute les morceaux disponibles et conserve tes découvertes préférées dans ta playlist.</p>
        {% if app.user %}<a href="{{ path('app_public_music_playlist') }}" class="mt-5 inline-flex rounded-full border border-mythic-gold/60 bg-white px-5 py-2.5 text-xs font-semibold text-[#80600f] shadow-sm transition hover:bg-[#fff8df]">Ouvrir ma playlist</a>{% endif %}
    </header>

    <section class="mt-10 grid gap-5 sm:grid-cols-2" aria-label="Musiques disponibles">
        {% for music in musics %}
            {% include 'music/_card.html.twig' with {music: music, playlistIds: playlistIds} only %}
        {% else %}
            <p class="sm:col-span-2 rounded-2xl border border-dashed border-[#d9d3c2] bg-white/60 px-5 py-10 text-center text-sm text-slate-500">Aucune musique n’est encore disponible.</p>
        {% endfor %}
    </section>
{% endblock %}
