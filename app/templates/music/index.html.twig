{% extends 'public/content/_layout.html.twig' %}
{% block title %}Bibliothèque musicale — Le Menhir des Dieux{% endblock %}
{% block content %}
    {% include 'music/_flashes.html.twig' %}
    <header class="relative overflow-hidden rounded-[1.6rem] bg-[#153f35] px-6 py-8 text-white shadow-[0_14px_35px_rgba(20,58,49,0.22)] sm:px-10 sm:py-10">
        <img src="{{ asset('images/placeholders/pantheon-irlandais.png') }}" alt="" class="absolute inset-0 size-full object-cover opacity-30" aria-hidden="true">
        <div class="absolute inset-0 bg-gradient-to-r from-[#102f28]/95 via-[#153f35]/80 to-[#153f35]/45" aria-hidden="true"></div>
        <div class="relative max-w-xl"><p class="text-[9px] font-semibold uppercase tracking-[0.22em] text-[#f0cf66]">Mélodies des divinités</p><h1 class="mt-2 font-mythic text-3xl leading-tight sm:text-5xl">Bibliothèque musicale</h1><p class="mt-4 text-sm leading-6 text-white/85">Explore les mélodies du monde celtique, écoute chaque morceau et conserve tes découvertes préférées.</p>{% if app.user %}<a href="{{ path('app_public_music_playlist') }}" class="mt-5 inline-flex rounded-full border border-[#f0cf66]/70 bg-[#fffefa]/10 px-5 py-2.5 text-xs font-semibold text-[#f7dda0] backdrop-blur hover:bg-[#fffefa]/20">Ouvrir ma playlist</a>{% endif %}</div>
    </header>

    <section class="mt-8 pb-44" aria-labelledby="library-title">
        <div class="flex items-end justify-between gap-4 border-l-2 border-mythic-gold pl-3"><div><p class="text-[9px] uppercase tracking-[0.2em] text-[#9a7620]">Disponible à l’écoute</p><h2 id="library-title" class="mt-1 font-mythic text-xl text-forest-900 sm:text-2xl">Hymnes des Anciens</h2></div><span class="text-xs text-slate-400">{{ musics|length }} morceau{{ musics|length > 1 ? 'x' : '' }}</span></div>
        <div class="mt-5 space-y-3">
            {% for music in musics %}
                {% set audioUrl = music.filePath starts with 'http://' or music.filePath starts with 'https://' ? music.filePath : asset(music.filePath|trim('/')) %}
                {% set portrait = music.dieu and music.dieu.img ? asset('uploads/dieux/' ~ music.dieu.img) : asset('images/logo-menhir-officiel.png') %}
                <article class="group flex items-center gap-3 rounded-2xl border border-[#e5e1d7] bg-white p-3 shadow-[0_5px_16px_rgba(35,63,53,0.06)] transition hover:-translate-y-0.5 hover:border-mythic-gold/50" data-track data-src="{{ audioUrl }}" data-title="{{ music.title }}" data-artist="{{ music.artist }}" data-image="{{ portrait }}">
                    <button type="button" class="relative h-16 w-12 shrink-0 overflow-hidden rounded-xl border-2 border-mythic-gold/45 bg-[#173d34] shadow-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-mythic-gold" data-track-play aria-label="Écouter {{ music.title }}"><img src="{{ portrait }}" alt="" class="size-full object-cover object-top" aria-hidden="true"><span class="absolute inset-0 flex items-center justify-center bg-[#102f28]/45 text-lg text-white opacity-0 transition group-hover:opacity-100" aria-hidden="true">▶</span></button>
                    <button type="button" class="min-w-0 flex-1 text-left focus-visible:rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-mythic-gold" data-track-play><strong class="block truncate text-sm text-forest-900">{{ music.title }}</strong><span class="mt-1 block truncate text-[9px] uppercase tracking-[0.08em] text-slate-500">{{ music.dieu ? music.dieu.name : music.artist }}</span></button>
                    <span class="hidden shrink-0 text-[10px] tabular-nums text-slate-400 min-[430px]:block" data-track-duration>--:--</span>
                    {% if app.user %}{% if music.id in playlistIds %}<form method="post" action="{{ path('app_public_music_remove', {id: music.id}) }}" class="shrink-0"><input type="hidden" name="_token" value="{{ csrf_token('playlist-remove-' ~ music.id) }}"><button type="submit" class="rounded-full border border-[#9d5d62]/35 bg-[#fff8f7] px-3 py-2 text-[9px] font-semibold text-[#8a454b] hover:bg-[#fbeceb]">Retirer</button></form>{% else %}<form method="post" action="{{ path('app_public_music_add', {id: music.id}) }}" class="shrink-0"><input type="hidden" name="_token" value="{{ csrf_token('playlist-add-' ~ music.id) }}"><button type="submit" class="rounded-full bg-[#1d5648] px-3 py-2 text-[9px] font-semibold text-white shadow-sm hover:bg-[#143f35]">+ Ajouter</button></form>{% endif %}{% else %}<a href="{{ path('app_login') }}" class="shrink-0 rounded-full border border-mythic-gold/50 px-3 py-2 text-[9px] font-semibold text-[#80600f]">Connexion</a>{% endif %}
                </article>
            {% else %}<p class="rounded-2xl border border-dashed border-[#d9d3c2] bg-white/60 px-5 py-10 text-center text-sm text-slate-500">Aucune musique n’est encore disponible.</p>{% endfor %}
        </div>
    </section>

    {% if musics is not empty %}
        {% set firstMusic = musics|first %}{% set firstAudioUrl = firstMusic.filePath starts with 'http://' or firstMusic.filePath starts with 'https://' ? firstMusic.filePath : asset(firstMusic.filePath|trim('/')) %}{% set firstPortrait = firstMusic.dieu and firstMusic.dieu.img ? asset('uploads/dieux/' ~ firstMusic.dieu.img) : asset('images/logo-menhir-officiel.png') %}
        <aside class="fixed inset-x-3 bottom-[76px] z-40 mx-auto max-w-xl rounded-2xl border border-[#ded8ca] bg-[#fffefa]/95 p-3 shadow-[0_10px_35px_rgba(18,48,40,0.2)] backdrop-blur-md sm:bottom-[82px]" aria-label="Lecteur musical"><div class="flex items-center gap-3"><img src="{{ firstPortrait }}" alt="" class="h-14 w-11 rounded-xl border-2 border-mythic-gold/45 bg-[#173d34] object-cover object-top shadow-sm" data-player-image aria-hidden="true"><div class="min-w-0 flex-1"><strong class="block truncate text-xs text-forest-900" data-player-title>{{ firstMusic.title }}</strong><span class="mt-0.5 block truncate text-[8px] uppercase tracking-[0.08em] text-slate-500" data-player-artist>{{ firstMusic.artist }}</span></div><button type="button" class="flex size-11 shrink-0 items-center justify-center rounded-full bg-[#8a6a00] text-lg text-white shadow-md hover:bg-[#6f5500]" data-player-toggle aria-label="Lire le morceau">▶</button></div><div class="mt-2 flex items-center gap-2 text-[8px] tabular-nums text-slate-500"><span data-player-current>0:00</span><input type="range" min="0" max="100" value="0" class="h-1 flex-1 accent-[#8a6a00]" data-player-progress aria-label="Position dans le morceau"><span data-player-duration>--:--</span></div><audio preload="metadata" src="{{ firstAudioUrl }}" data-audio-player></audio></aside>
    {% endif %}
{% endblock %}

{% block javascripts %}{{ parent() }}<script>
document.addEventListener('DOMContentLoaded',()=>{const a=document.querySelector('[data-audio-player]');if(!a)return;const b=document.querySelector('[data-player-toggle]'),p=document.querySelector('[data-player-progress]'),c=document.querySelector('[data-player-current]'),d=document.querySelector('[data-player-duration]'),t=document.querySelector('[data-player-title]'),r=document.querySelector('[data-player-artist]'),i=document.querySelector('[data-player-image]');const f=s=>Number.isFinite(s)?`${Math.floor(s/60)}:${String(Math.floor(s%60)).padStart(2,'0')}`:'--:--';const state=()=>{const play=!a.paused;b.textContent=play?'Ⅱ':'▶';b.setAttribute('aria-label',play?'Mettre en pause':'Lire le morceau')};document.querySelectorAll('[data-track]').forEach(x=>{const m=new Audio(x.dataset.src);m.preload='metadata';m.addEventListener('loadedmetadata',()=>{const o=x.querySelector('[data-track-duration]');if(o)o.textContent=f(m.duration)});x.querySelectorAll('[data-track-play]').forEach(k=>k.addEventListener('click',()=>{const changed=a.src!==new URL(x.dataset.src,location.href).href;if(changed)a.src=x.dataset.src;t.textContent=x.dataset.title;r.textContent=x.dataset.artist;i.src=x.dataset.image;document.querySelectorAll('[data-track]').forEach(y=>y.classList.remove('border-mythic-gold','bg-[#fffaf0]'));x.classList.add('border-mythic-gold','bg-[#fffaf0]');changed||a.paused?a.play():a.pause()}))});b.addEventListener('click',()=>a.paused?a.play():a.pause());a.addEventListener('play',state);a.addEventListener('pause',state);a.addEventListener('loadedmetadata',()=>d.textContent=f(a.duration));a.addEventListener('timeupdate',()=>{c.textContent=f(a.currentTime);p.value=a.duration?String(a.currentTime/a.duration*100):'0'});p.addEventListener('input',()=>{if(a.duration)a.currentTime=Number(p.value)/100*a.duration})});
</script>{% endblock %}
