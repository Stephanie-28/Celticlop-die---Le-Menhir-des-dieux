{% if is_granted('ROLE_ADMIN') %}
    {% set label = ('Modifier ' ~ contentType ~ ' ' ~ contentName)|replace({'  ': ' '}) %}
    {% if editUrl|default(null) %}
        <a href="{{ editUrl }}" class="inline-flex size-11 items-center justify-center rounded-full border border-mythic-gold/60 bg-white/95 text-[#8b6b1d] shadow-md transition hover:bg-[#fff8df] focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-[#123b31]" aria-label="{{ label }}">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="size-5"><path d="M4.5 19.5l4.2-1 9.9-9.9a2.12 2.12 0 00-3-3l-9.9 9.9-1.2 4zM14.3 6.9l2.8 2.8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
    {% else %}
        <span class="inline-flex size-11 items-center justify-center rounded-full border border-mythic-gold/35 bg-white/90 text-[#9a8b63] shadow-sm" role="img" aria-label="{{ label }} — outil à venir" title="Modification à venir">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="size-5"><path d="M4.5 19.5l4.2-1 9.9-9.9a2.12 2.12 0 00-3-3l-9.9 9.9-1.2 4zM14.3 6.9l2.8 2.8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
    {% endif %}
{% endif %}
