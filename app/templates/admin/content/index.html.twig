{% extends 'admin/base.html.twig' %}

{% block title %}{{ title }} — Administration{% endblock %}

{% block admin_content %}
    <section aria-labelledby="content-title">
        <p class="text-[10px] font-semibold uppercase tracking-[0.24em] text-[#967321]">{{ userStory }}</p>
        <div class="mt-2 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
            <div><h1 id="content-title" class="font-mythic text-2xl text-admin-forest sm:text-3xl">{{ title }}</h1><p class="mt-2 max-w-2xl text-sm leading-6 text-[#5c706a]">{{ description }}</p></div>
            <a href="{{ path(newRoute) }}" class="inline-flex min-h-11 items-center justify-center rounded-full bg-admin-forest px-5 py-3 text-sm font-semibold text-white shadow-md transition hover:bg-[#1b5144] focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-mythic-gold">{{ newLabel }}</a>
        </div>
    </section>

    <section class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-3" aria-label="Liste des contenus">
        {% for item in items %}
            <article class="flex min-w-0 flex-col rounded-2xl border border-white bg-admin-ivory p-5 shadow-[0_8px_24px_rgba(24,58,48,0.07)]">
                <p class="text-[9px] font-semibold uppercase tracking-[0.18em] text-[#967321]">Archive nº {{ item.id }}</p>
                <h2 class="mt-2 break-words font-mythic text-lg text-admin-forest">{{ attribute(item, displayProperty) }}</h2>
                {% if subtitleProperty and attribute(item, subtitleProperty) %}<p class="mt-2 line-clamp-3 text-xs leading-5 text-[#64766f]">{{ attribute(item, subtitleProperty) }}</p>{% endif %}
                {% if countProperty %}<p class="mt-3 text-[10px] uppercase tracking-[0.13em] text-[#71847d]">{{ attribute(item, countProperty)|length }} relation{{ attribute(item, countProperty)|length > 1 ? 's' : '' }}</p>{% endif %}
                <div class="mt-auto flex flex-wrap gap-2 pt-5">
                    <a href="{{ path(editRoute, {id: item.id}) }}" class="rounded-full border border-admin-forest/25 px-3 py-2 text-xs font-semibold text-admin-forest transition hover:border-mythic-gold focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-mythic-gold">Modifier</a>
                    <form method="post" action="{{ path(deleteRoute, {id: item.id}) }}" onsubmit="return confirm('Confirmer la suppression de cette archive ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token(deleteTokenPrefix ~ item.id) }}">
                        <button type="submit" class="rounded-full border border-[#9d6b6b]/35 px-3 py-2 text-xs font-semibold text-[#854f55] transition hover:bg-[#fff4f3] focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-[#854f55]">Supprimer</button>
                    </form>
                </div>
            </article>
        {% else %}
            <div class="sm:col-span-2 xl:col-span-3 rounded-2xl border border-dashed border-[#c7c0aa] bg-white p-10 text-center text-sm text-[#71847d]">Aucune archive dans ce domaine.</div>
        {% endfor %}
    </section>
{% endblock %}
