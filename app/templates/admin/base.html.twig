{% extends 'base.html.twig' %}

{% set adminNavigation = [
    {label: 'Tableau de bord', key: 'dashboard', route: 'app_admin_dashboard', available: true},
    {label: 'Divinités', actionLabel: 'Ajouter un Dieu', key: 'deities', available: false},
    {label: 'Panthéons', actionLabel: 'Ajouter un Panthéon', key: 'pantheons', available: false},
    {label: 'Symboles', actionLabel: 'Ajouter un Symbole', key: 'symbols', available: false},
    {label: 'Bestiaire', actionLabel: 'Ajouter un Animal sacré', key: 'animals', available: false},
    {label: 'Mythes', actionLabel: 'Ajouter un Mythe', key: 'myths', available: false},
    {label: 'Chroniques', actionLabel: 'Ajouter une Chronique', key: 'chronicles', available: false},
    {label: 'Savoirs préservés', actionLabel: 'Ajouter un Savoir préservé', key: 'knowledge', available: false},
    {label: 'Musique', actionLabel: 'Ajouter une Musique', key: 'music', available: false},
    {label: 'Quiz', actionLabel: 'Ajouter / gérer le Quiz', key: 'quiz', available: false}
] %}

{% block stylesheets %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Metamorphous&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <style type="text/tailwindcss">
        @theme {
            --font-mythic: "Metamorphous", serif;
            --font-editorial: "Lora", serif;
            --color-mythic-gold: #d3aa32;
            --color-admin-forest: #123b31;
            --color-admin-ink: #29473f;
            --color-admin-ivory: #fbf8ef;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="min-h-screen bg-[#f1f3ef] font-editorial text-admin-ink">
        <header class="sticky top-0 z-40 border-b border-mythic-gold/35 bg-admin-ivory/95 shadow-sm backdrop-blur" aria-label="En-tête de l’administration">
            <div class="mx-auto flex h-[4.5rem] max-w-[96rem] items-center gap-3 px-4 sm:px-6">
                <button id="admin-menu-open" type="button" class="flex size-10 items-center justify-center rounded-full border border-admin-forest/20 text-admin-forest transition hover:border-mythic-gold focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-mythic-gold lg:hidden" aria-controls="admin-sidebar" aria-expanded="false" aria-label="Ouvrir la navigation de l’administration">
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="size-5"><path d="M4 7H20M4 12H20M4 17H20" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                </button>
                <a href="{{ path('app_admin_dashboard') }}" class="flex min-w-0 items-center gap-3 rounded-lg focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-mythic-gold">
                    <img src="{{ asset('images/logo-menhir.jpeg') }}" alt="" class="size-10 rounded-full border border-mythic-gold/50 object-cover">
                    <span class="min-w-0"><span class="block truncate font-mythic text-sm text-admin-forest sm:text-base">Celticlopédie</span><span class="block truncate text-[9px] uppercase tracking-[0.17em] text-[#8b6b1d]">Sanctuaire du Grand Druide</span></span>
                </a>
                <nav class="ml-auto flex items-center gap-2" aria-label="Liens du Grand Druide">
                    <a href="{{ path('app_home') }}" class="hidden rounded-full px-3 py-2 text-xs font-semibold text-admin-forest transition hover:bg-white hover:text-[#8b6b1d] focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-mythic-gold sm:inline-flex">Voir le site public</a>
                    <a href="{{ path('app_profile') }}" class="flex size-10 items-center justify-center overflow-hidden rounded-full border-2 border-mythic-gold/70 bg-[#e8dfc7] font-mythic text-sm text-admin-forest shadow-sm focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-admin-forest" aria-label="Ouvrir mon profil">
                        {% if app.user.avatar %}<img src="{{ asset('uploads/avatars/' ~ app.user.avatar) }}" alt="" class="size-full object-cover">{% else %}{{ app.user.pseudo|first|upper }}{% endif %}
                    </a>
                    <a href="{{ path('app_logout') }}" class="hidden rounded-full border border-[#9d6b6b]/35 px-3 py-2 text-xs font-semibold text-[#854f55] transition hover:bg-[#fff4f3] focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-[#854f55] sm:inline-flex">Déconnexion</a>
                </nav>
            </div>
        </header>

        <div class="mx-auto flex max-w-[96rem]">
            <div id="admin-menu-backdrop" class="fixed inset-0 z-40 hidden bg-[#09251f]/55 backdrop-blur-sm lg:hidden" aria-hidden="true"></div>
            <aside id="admin-sidebar" class="fixed inset-y-0 left-0 z-50 w-[min(19rem,88vw)] -translate-x-full overflow-y-auto bg-admin-forest px-4 pb-8 pt-5 text-white shadow-2xl transition-transform duration-200 motion-reduce:transition-none lg:sticky lg:top-[4.5rem] lg:z-20 lg:block lg:h-[calc(100vh-4.5rem)] lg:w-72 lg:shrink-0 lg:translate-x-0 lg:shadow-none" aria-label="Navigation de l’administration">
                <div class="mb-5 flex items-center justify-between lg:hidden"><span class="font-mythic text-sm text-[#f0d57e]">Administration</span><button id="admin-menu-close" type="button" class="flex size-10 items-center justify-center rounded-full border border-white/25 focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-[#f0d57e]" aria-label="Fermer la navigation">×</button></div>
                <p class="px-3 text-[9px] uppercase tracking-[0.24em] text-[#d9c37d]">Gestion du contenu</p>
                <nav class="mt-3 space-y-1.5">
                    {% for item in adminNavigation %}
                        {% if item.available %}
                            <a href="{{ path(item.route) }}" class="flex items-center justify-between rounded-xl bg-white/12 px-3 py-3 text-sm font-semibold text-white ring-1 ring-white/12 transition hover:bg-white/18 focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-[#f0d57e]" aria-current="page"><span>{{ item.label }}</span><span class="text-[#f0d57e]" aria-hidden="true">◆</span></a>
                        {% else %}
                            <span class="flex cursor-not-allowed items-center justify-between rounded-xl px-3 py-2.5 text-sm text-white/65" aria-disabled="true"><span>{{ item.label }}</span><span class="rounded-full border border-white/15 px-2 py-0.5 text-[8px] uppercase tracking-wider text-white/55">À venir</span></span>
                        {% endif %}
                    {% endfor %}
                </nav>
                <div class="mt-7 space-y-2 border-t border-white/12 pt-5 sm:hidden">
                    <a href="{{ path('app_home') }}" class="block rounded-lg px-3 py-2 text-sm text-white/80 focus-visible:outline-3 focus-visible:outline-[#f0d57e]">Voir le site public</a>
                    <a href="{{ path('app_logout') }}" class="block rounded-lg px-3 py-2 text-sm text-[#f3b9b9] focus-visible:outline-3 focus-visible:outline-[#f0d57e]">Déconnexion</a>
                </div>
            </aside>

            <main class="min-w-0 flex-1 px-4 py-7 sm:px-7 sm:py-9 lg:px-10" id="admin-content">
                {% block admin_content %}{% endblock %}
            </main>
        </div>
    </div>

    <script>
        (() => {
            const sidebar = document.getElementById('admin-sidebar');
            const backdrop = document.getElementById('admin-menu-backdrop');
            const openButton = document.getElementById('admin-menu-open');
            const closeButton = document.getElementById('admin-menu-close');
            const openMenu = () => { sidebar?.classList.remove('-translate-x-full'); backdrop?.classList.remove('hidden'); openButton?.setAttribute('aria-expanded', 'true'); closeButton?.focus(); };
            const closeMenu = () => { sidebar?.classList.add('-translate-x-full'); backdrop?.classList.add('hidden'); openButton?.setAttribute('aria-expanded', 'false'); openButton?.focus(); };
            openButton?.addEventListener('click', openMenu);
            closeButton?.addEventListener('click', closeMenu);
            backdrop?.addEventListener('click', closeMenu);
            document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && openButton?.getAttribute('aria-expanded') === 'true') closeMenu(); });
        })();
    </script>
{% endblock %}

{% block grand_druid_tools %}{% endblock %}
