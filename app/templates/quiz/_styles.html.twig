<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Metamorphous&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
<style type="text/tailwindcss">
    @theme {
        --font-mythic: "Metamorphous", serif;
        --font-editorial: "Lora", serif;
        --color-celestial-50: #f3f8fc;
        --color-celestial-100: #e7f1f8;
        --color-celestial-600: #4f7890;
        --color-celestial-800: #34576d;
        --color-mythic-gold: #d3aa32;
    }

    @keyframes quiz-question-enter {
        from {
            opacity: 0;
            transform: translateY(5px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .quiz-question-shell {
        animation: quiz-question-enter 180ms ease-out both;
        view-transition-name: quiz-question;
    }

    .quiz-progress {
        view-transition-name: quiz-progress;
    }

    @view-transition {
        navigation: auto;
    }

    ::view-transition-old(quiz-question),
    ::view-transition-new(quiz-question) {
        animation-duration: 180ms;
        animation-timing-function: ease-out;
    }

    @media (prefers-reduced-motion: reduce) {
        .quiz-question-shell {
            animation: none;
        }

        ::view-transition-group(*),
        ::view-transition-old(*),
        ::view-transition-new(*) {
            animation-duration: 0.001ms;
        }
    }
</style>
