{% extends 'base.html.twig' %}

{% block title %}Question {{ position }} sur {{ total }} — Quiz{% endblock %}

{% block stylesheets %}
    {% include 'quiz/_styles.html.twig' %}
{% endblock %}

{% block body %}
    {% include '_partials/_header.html.twig' %}

    <main class="min-h-screen bg-celestial-50 px-4 pb-28 pt-7 font-editorial text-celestial-800 sm:pt-10">
        <section class="mx-auto max-w-3xl" aria-labelledby="question-title">
            <div class="quiz-progress mb-6" aria-label="Progression du quiz : question {{ position }} sur {{ total }}">
                <div class="flex items-center justify-between text-sm">
                    <span class="font-semibold">Question {{ position }} sur {{ total }}</span>
                    <span class="text-slate-500">{{ ((position / total) * 100)|round }}&nbsp;%</span>
                </div>
                <div class="mt-2 h-2 overflow-hidden rounded-full bg-white" aria-hidden="true">
                    <div class="h-full rounded-full bg-mythic-gold transition-[width]" style="width: {{ (position / total) * 100 }}%"></div>
                </div>
            </div>

            <form action="{{ path('app_quiz_answer') }}" method="post" class="quiz-question-shell flex min-h-[620px] flex-col rounded-3xl bg-white p-6 shadow-[0_14px_38px_rgba(52,87,109,0.1)] sm:min-h-[650px] sm:p-10">
                <input type="hidden" name="_token" value="{{ csrf_token('quiz-answer-' ~ attemptNonce) }}">
                <input type="hidden" name="question" value="{{ question.id }}">
                <input type="hidden" name="position" value="{{ position }}">

                <fieldset class="flex flex-1 flex-col">
                    <legend id="question-title" class="min-h-28 font-mythic text-2xl leading-relaxed sm:min-h-32 sm:text-3xl">{{ question.prompt }}</legend>

                    {% for message in app.flashes('quiz_error') %}
                        <p role="alert" class="mt-5 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{{ message }}</p>
                    {% endfor %}

                    <div class="mt-6 grid flex-1 auto-rows-fr gap-4 sm:mt-8">
                        {% for answer in question.answers %}
                            <label class="group relative flex min-h-20 cursor-pointer items-center gap-4 rounded-2xl border border-celestial-100 px-5 py-4 transition hover:border-mythic-gold/70 hover:bg-[#fffaf0] focus-within:border-mythic-gold focus-within:outline-3 focus-within:outline-offset-2 focus-within:outline-celestial-800 has-[:checked]:border-mythic-gold has-[:checked]:bg-[#fffaf0]">
                                <input class="peer size-5 shrink-0 accent-[#d3aa32]" type="radio" name="answer" value="{{ answer.id }}" {{ selectedAnswer == answer.id ? 'checked' : '' }} required>
                                <span class="leading-6 text-slate-700 peer-checked:text-celestial-800">{{ answer.label }}</span>
                            </label>
                        {% endfor %}
                    </div>
                </fieldset>

                <div class="mt-8 grid min-h-11 grid-cols-[auto_1fr] items-center gap-3 sm:gap-4">
                    {% if position > 1 %}
                        <a href="{{ path('app_quiz_question', {position: position - 1}) }}" class="inline-flex min-h-11 items-center rounded-full border border-celestial-100 px-4 py-2 text-xs transition hover:border-celestial-600 focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-celestial-800 sm:px-5 sm:text-sm">← Précédente</a>
                    {% else %}
                        <span aria-hidden="true"></span>
                    {% endif %}

                    <button class="inline-flex min-h-11 items-center justify-self-end rounded-full bg-mythic-gold px-4 py-2 text-xs font-semibold text-white transition hover:bg-[#bd9424] focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-celestial-800 sm:px-6 sm:text-base">
                        {{ position == total ? 'Découvrir mon résultat' : 'Question suivante →' }}
                    </button>
                </div>
            </form>
        </section>
    </main>

    {% include '_partials/_bottom_nav.html.twig' %}
{% endblock %}
