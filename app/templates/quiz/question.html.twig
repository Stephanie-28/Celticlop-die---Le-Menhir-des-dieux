{% extends 'base.html.twig' %}

{% block title %}Question {{ position }} sur {{ total }} — Quiz{% endblock %}

{% block stylesheets %}
    {% include 'quiz/_styles.html.twig' %}
{% endblock %}

{% block body %}
    {% include '_partials/_header.html.twig' %}

    <main class="min-h-screen bg-celestial-50 px-4 pb-28 pt-6 font-editorial text-celestial-800 sm:pt-8">
        <section class="mx-auto max-w-md" aria-labelledby="question-title">
            <div class="quiz-progress mb-5 text-center" aria-label="Progression du quiz : question {{ position }} sur {{ total }}">
                <div class="mb-2 flex items-center justify-center gap-2" aria-hidden="true">
                    <span class="size-1 rounded-full bg-celestial-600/30"></span>
                    <span class="h-0.5 w-5 rounded-full bg-mythic-gold"></span>
                    <span class="size-1 rounded-full bg-celestial-600/30"></span>
                </div>
                <div class="text-[10px] font-semibold uppercase tracking-[0.22em] text-celestial-600">
                    Étape {{ '%02d'|format(position) }} sur {{ '%02d'|format(total) }}
                </div>
                <div class="mt-4 h-1 overflow-hidden rounded-full bg-white" aria-hidden="true">
                    <div class="h-full rounded-full bg-gradient-to-r from-celestial-600 to-[#d9c8ef] transition-[width]" style="width: {{ (position / total) * 100 }}%"></div>
                </div>
            </div>

            <form action="{{ path('app_quiz_answer') }}" method="post" class="quiz-question-shell flex min-h-[660px] flex-col py-3 sm:min-h-[690px]">
                <input type="hidden" name="_token" value="{{ csrf_token('quiz-answer-' ~ attemptNonce) }}">
                <input type="hidden" name="question" value="{{ question.id }}">
                <input type="hidden" name="position" value="{{ position }}">

                <fieldset class="flex flex-1 flex-col">
                    <legend id="question-title" class="mx-auto min-h-36 max-w-sm text-center font-mythic text-[25px] leading-[1.3] text-slate-900 sm:min-h-40 sm:text-[29px]">{{ question.prompt }}</legend>

                    {% for message in app.flashes('quiz_error') %}
                        <p role="alert" class="mt-5 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{{ message }}</p>
                    {% endfor %}

                    <div class="mt-4 grid flex-1 auto-rows-fr gap-3 sm:mt-5">
                        {% for answer in question.answers %}
                            <label class="group relative flex min-h-[76px] cursor-pointer items-center gap-4 rounded-xl border border-white bg-white px-4 py-3 shadow-[0_5px_16px_rgba(52,87,109,0.05)] transition hover:border-mythic-gold/60 hover:bg-[#fffdf8] focus-within:border-mythic-gold focus-within:outline-3 focus-within:outline-offset-2 focus-within:outline-celestial-800 has-[:checked]:border-mythic-gold has-[:checked]:bg-[#fffdf8]">
                                <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-celestial-50 text-sm text-celestial-600 transition group-has-[:checked]:bg-[#fff4cf] group-has-[:checked]:text-mythic-gold" aria-hidden="true">✦</span>
                                <input class="peer sr-only" type="radio" name="answer" value="{{ answer.id }}" {{ selectedAnswer == answer.id ? 'checked' : '' }} required>
                                <span class="text-[15px] leading-5 text-slate-700 peer-checked:text-celestial-800">{{ answer.label }}</span>
                            </label>
                        {% endfor %}
                    </div>
                </fieldset>

                <div class="mt-7 grid min-h-11 grid-cols-[auto_1fr] items-center gap-3 sm:gap-4">
                    {% if position > 1 %}
                        <a href="{{ path('app_quiz_question', {position: position - 1}) }}" class="inline-flex min-h-10 items-center px-2 py-2 text-[11px] uppercase tracking-wider text-mythic-gold transition hover:text-celestial-800 focus-visible:rounded-full focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-celestial-800">← Retour</a>
                    {% else %}
                        <span aria-hidden="true"></span>
                    {% endif %}

                    <button class="inline-flex min-h-10 items-center justify-self-end rounded-full bg-mythic-gold px-6 py-2 text-[11px] font-semibold uppercase tracking-wider text-white shadow-[0_6px_16px_rgba(211,170,50,0.25)] transition hover:bg-[#bd9424] focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-celestial-800">
                        {{ position == total ? 'Découvrir mon résultat' : 'Question suivante →' }}
                    </button>
                </div>
            </form>
        </section>
    </main>

    {% include '_partials/_bottom_nav.html.twig' %}
{% endblock %}
