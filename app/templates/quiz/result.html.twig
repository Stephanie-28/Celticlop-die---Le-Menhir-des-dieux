{% extends 'base.html.twig' %}

{% block title %}{{ dieu.name }} est ton dieu protecteur — Quiz{% endblock %}

{% block stylesheets %}
    {% include 'quiz/_styles.html.twig' %}
{% endblock %}

{% block body %}
    {% include '_partials/_header.html.twig' %}

    <main class="min-h-screen bg-celestial-50 px-4 pb-28 pt-7 font-editorial text-celestial-800 sm:pt-10">
        <article class="mx-auto max-w-md overflow-hidden rounded-2xl border border-white bg-white shadow-[0_12px_32px_rgba(52,87,109,0.08)]" aria-labelledby="result-title">
            {% if dieu.img %}
                <img src="{{ asset('uploads/dieux/' ~ dieu.img) }}" alt="Portrait de {{ dieu.name }}" class="max-h-[520px] w-full bg-celestial-50 object-contain">
            {% endif %}

            <div class="px-6 py-8 text-center sm:px-9 sm:py-10">
                <p class="text-xs uppercase tracking-[0.24em] text-mythic-gold">Ton dieu protecteur</p>
                <h1 id="result-title" class="mt-3 font-mythic text-4xl">{{ dieu.name }}</h1>
                {% set pantheon = dieu.pantheons|first %}
                {% if pantheon %}
                    <p class="mt-2 text-sm text-slate-500">{{ pantheon.title }}</p>
                {% endif %}
                <p class="mx-auto mt-6 max-w-xl text-left leading-7 text-slate-600">{{ dieu.description|striptags|slice(0, 420) }}{{ dieu.description|length > 420 ? '…' : '' }}</p>

                {% for message in app.flashes('quiz_success') %}
                    <p role="status" class="mx-auto mt-6 max-w-lg rounded-xl border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">{{ message }}</p>
                {% endfor %}

                <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row sm:flex-wrap">
                    <a href="{{ path('app_public_dieu_show', {id: dieu.id}) }}" class="inline-flex min-h-12 w-full items-center justify-center rounded-full bg-mythic-gold px-6 py-3 font-semibold text-white transition hover:bg-[#bd9424] focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-celestial-800 sm:w-auto">Découvrir sa fiche complète</a>

                    {% if not isFavorite %}
                        <form action="{{ path('app_quiz_favorite') }}" method="post" class="w-full sm:w-auto">
                            <input type="hidden" name="_token" value="{{ csrf_token('quiz-favorite-' ~ attemptNonce) }}">
                            <button class="inline-flex min-h-12 w-full items-center justify-center rounded-full border border-mythic-gold px-6 py-3 text-mythic-gold transition hover:bg-[#fffaf0] focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-celestial-800 sm:w-auto">Ajouter à mes favoris</button>
                        </form>
                    {% else %}
                        <p class="inline-flex min-h-12 items-center rounded-full border border-green-200 bg-green-50 px-6 py-3 text-sm text-green-800">Déjà dans tes favoris</p>
                    {% endif %}
                </div>

                <form action="{{ path('app_quiz_start') }}" method="post" class="mt-5">
                    <input type="hidden" name="_token" value="{{ csrf_token('quiz-start') }}">
                    <button class="rounded-sm px-3 py-2 text-sm text-celestial-600 underline decoration-mythic-gold/50 underline-offset-4 focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-celestial-800">Recommencer le Quiz</button>
                </form>
            </div>
        </article>
    </main>

    {% include '_partials/_bottom_nav.html.twig' %}
{% endblock %}
