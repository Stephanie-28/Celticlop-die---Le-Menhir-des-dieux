{% extends 'base.html.twig' %}

{% block title %}{{ animal.name }} — Le Menhir des Dieux{% endblock %}

{% block stylesheets %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Metamorphous&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <style type="text/tailwindcss">
        @theme {
            --font-mythic: "Metamorphous", serif;
            --font-editorial: "Lora", serif;
            --color-celestial-50: #f3f8fc;
            --color-celestial-100: #e7f1f8;
            --color-celestial-600: #4f7890;
            --color-celestial-800: #34576d;
            --color-mythic-gold: #d3aa32;
        }
    </style>
{% endblock %}

{% block body %}
    {% include '_partials/_header.html.twig' %}

    <main class="min-h-screen overflow-x-hidden bg-[#f7fafc] pb-28 font-editorial text-celestial-800">
        <article class="mx-auto max-w-3xl">
            <section class="overflow-hidden bg-white shadow-[0_8px_24px_rgba(52,87,109,0.08)] sm:mt-8 sm:rounded-3xl" aria-labelledby="animal-title">
                {% if animal.img %}
                    <div class="aspect-[3/2] w-full overflow-hidden bg-celestial-50">
                        <img src="{{ asset('uploads/animaux/' ~ animal.img) }}" alt="{{ animal.name }}" class="h-full w-full object-cover object-center">
                    </div>
                {% endif %}

                <div class="px-5 py-7 sm:px-9 sm:py-9">
                    <p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-mythic-gold">Animal symbolique</p>
                    <h1 id="animal-title" class="mt-3 font-mythic text-3xl uppercase text-celestial-800 sm:text-4xl">{{ animal.name }}</h1>
                    {% if animal.description %}
                        <div class="mt-6 whitespace-pre-line text-[14px] leading-7 text-slate-600 sm:text-[15px]">{{ animal.description }}</div>
                    {% endif %}
                </div>
            </section>

            <div class="space-y-5 px-3 py-5 sm:px-0 sm:py-7">
                {% if animalChronicle and not app.user %}
                    <aside class="rounded-2xl border border-mythic-gold/35 bg-[#fffaf0] px-5 py-4 text-center text-sm leading-6 text-celestial-800" aria-label="Accès au contenu complet">
                        <p>
                            <a href="{{ path('app_login') }}" class="rounded-sm font-semibold text-mythic-gold underline decoration-mythic-gold/45 underline-offset-4 transition hover:text-celestial-800 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-celestial-800">Connectez-vous</a>
                            pour accéder aux chroniques sacrées et au contenu complet.
                        </p>
                    </aside>
                {% endif %}

                {% if animalChronicle and app.user %}
                    <section class="rounded-3xl bg-white px-5 py-7 shadow-[0_8px_24px_rgba(52,87,109,0.08)] sm:px-8" aria-labelledby="animal-chronicles-title">
                        <h2 id="animal-chronicles-title" class="flex items-center gap-2 font-mythic text-lg uppercase tracking-wide text-mythic-gold sm:text-xl">
                            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="size-5 shrink-0" xmlns="http://www.w3.org/2000/svg">
                                <path d="M5 5.5C7.5 4.8 9.7 5.2 12 6.7V19C9.7 17.5 7.5 17.1 5 17.8V5.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                                <path d="M19 5.5C16.5 4.8 14.3 5.2 12 6.7V19C14.3 17.5 16.5 17.1 19 17.8V5.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                            </svg>
                            Chroniques sacrées
                        </h2>

                        <div class="mt-5 space-y-5 text-[14px] leading-7 text-slate-600 sm:text-[15px]">
                            {% for paragraph in animalChronicle.paragraphs %}
                                <p>{{ paragraph }}</p>

                                {% if loop.index == 3 %}
                                    <blockquote class="my-7 border-l-2 border-mythic-gold pl-5 italic text-celestial-800 sm:my-8 sm:pl-6">
                                        {{ animalChronicle.highlight }}
                                    </blockquote>
                                {% endif %}
                            {% endfor %}
                        </div>
                    </section>
                {% endif %}

                {% if animal.dieux is not empty and (animalChronicle is null or app.user) %}
                    {% include 'public/_partials/_associated_deities.html.twig' with {dieux: animal.dieux, headingId: 'animal-associated-title'} only %}
                {% endif %}

                <nav class="flex items-center px-2 py-4" aria-label="Navigation de l’encyclopédie">
                    <a href="{{ path('app_public_pantheon_all') }}" class="inline-flex min-h-11 items-center gap-2 rounded-full text-xs uppercase tracking-wider text-mythic-gold transition hover:text-celestial-800 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-celestial-800">
                        <span aria-hidden="true">←</span>
                        Retour à l’Encyclopédie
                    </a>
                </nav>
            </div>
        </article>
    </main>

    {% include '_partials/_bottom_nav.html.twig' %}
{% endblock %}
