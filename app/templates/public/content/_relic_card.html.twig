<a href="{{ path(detailRoute, {id: item.id}) }}" class="group flex min-w-0 flex-col overflow-hidden rounded-3xl border border-[#e5dfcf] bg-white shadow-[0_8px_24px_rgba(45,70,62,0.08)] transition hover:-translate-y-1 hover:shadow-[0_14px_32px_rgba(45,70,62,0.14)] focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-mythic-gold" aria-label="Découvrir {{ item.name }}, {{ categoryLabel|lower }}">
    {% if item.img %}<div class="aspect-[4/3] overflow-hidden bg-[#f1f5f4]"><img src="{{ asset(imageDirectory ~ item.img) }}" alt="{{ item.name }}" class="block size-full object-contain object-center transition duration-300 group-hover:scale-[1.015]"></div>{% else %}<div class="flex aspect-[4/3] items-center justify-center bg-[#f1f5f4] text-3xl text-mythic-gold/60" aria-hidden="true">◇</div>{% endif %}
    <div class="flex flex-1 flex-col p-5"><p class="text-[9px] font-semibold uppercase tracking-[0.2em] text-mythic-gold">{{ categoryLabel }}</p><h3 class="mt-2 font-mythic text-lg text-celestial-800 sm:text-xl">{{ item.name }}</h3><p class="mt-3 line-clamp-3 text-sm leading-6 text-slate-600">{{ item.description }}</p><span class="mt-auto pt-5 text-xs font-semibold text-[#8a6a18]">Découvrir →</span></div>
</a>
