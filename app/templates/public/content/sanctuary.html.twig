{% extends 'public/content/_layout.html.twig' %}
{% block title %}Mon Sanctuaire — Le Menhir des Dieux{% endblock %}
{% block content %}
    <header class="text-center"><p class="text-[10px] uppercase tracking-[0.3em] text-mythic-gold">Trésors conservés</p><h1 class="mt-3 font-mythic text-3xl text-celestial-800 sm:text-5xl">Mon Sanctuaire</h1><p class="mx-auto mt-4 max-w-xl text-sm leading-7 text-slate-600">Retrouve les figures et savoirs que tu as choisis de préserver.</p></header>
    <div class="mt-9 space-y-8">
        {% for key, group in favoriteGroups %}
            <section id="{{ key }}" class="scroll-mt-5" aria-labelledby="group-{{ key }}"><div class="flex items-center justify-between border-b border-[#d9d5c9] pb-3"><h2 id="group-{{ key }}" class="font-mythic text-xl text-celestial-800 sm:text-2xl">{{ group.label }}</h2><span class="text-xs text-slate-400">{{ group.items|length }}</span></div>
                <div class="mt-4 grid grid-cols-1 gap-3 min-[390px]:grid-cols-2 sm:grid-cols-3">
                    {% for item in group.items %}<article class="overflow-hidden rounded-2xl border border-[#e6e0d1] bg-white shadow-[0_5px_16px_rgba(40,65,56,0.07)]">{% if item.image %}<img src="{{ asset(item.image) }}" alt="" class="aspect-[4/3] w-full object-cover">{% endif %}<div class="p-4"><h3 class="font-mythic text-sm text-celestial-800">{{ item.label }}</h3>{% if item.route %}<a href="{{ path(item.route, {id: item.id}) }}" class="mt-3 inline-flex text-xs font-semibold text-[#8a6a18]">Ouvrir →</a>{% endif %}</div></article>{% else %}<p class="col-span-full rounded-2xl border border-dashed border-[#d9d3c2] bg-white/60 px-5 py-7 text-center text-sm text-slate-500">Aucun favori dans cette catégorie.</p>{% endfor %}
                </div>
            </section>
        {% endfor %}
    </div>
{% endblock %}
