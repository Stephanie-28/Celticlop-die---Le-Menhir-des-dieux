{% extends 'public/content/_layout.html.twig' %}
{% block title %}Reliques Célestes — Le Menhir des Dieux{% endblock %}
{% block content %}
    <header class="text-center"><p class="text-[10px] uppercase tracking-[0.3em] text-mythic-gold">Symboles et bestiaire</p><h1 class="mt-3 font-mythic text-3xl text-celestial-800 sm:text-5xl">Reliques Célestes</h1><p class="mx-auto mt-4 max-w-2xl text-sm leading-7 text-slate-600">Explore les symboles et les animaux sacrés conservés dans Celticlopédie.</p></header>
    <section class="mt-10" aria-labelledby="sacred-symbols-title"><div class="flex items-end justify-between gap-4 border-b border-mythic-gold/30 pb-4"><div><p class="text-[9px] uppercase tracking-[0.24em] text-mythic-gold">Objets et signes</p><h2 id="sacred-symbols-title" class="mt-1 font-mythic text-2xl text-celestial-800 sm:text-3xl">Symboles sacrés</h2></div><span class="text-xs text-slate-400">{{ symboles|length }}</span></div><div class="mt-6 grid gap-5 min-[494px]:grid-cols-2 lg:grid-cols-3">{% for symbole in symboles %}{% include 'public/content/_relic_card.html.twig' with {item: symbole, categoryLabel: 'Symbole sacré', imageDirectory: 'uploads/symboles/', detailRoute: 'app_public_symbole_show'} only %}{% else %}<p class="col-span-full py-10 text-center text-slate-500">Aucun symbole sacré n’est disponible.</p>{% endfor %}</div></section>
    <section class="mt-12" aria-labelledby="sacred-animals-title"><div class="flex items-end justify-between gap-4 border-b border-mythic-gold/30 pb-4"><div><p class="text-[9px] uppercase tracking-[0.24em] text-mythic-gold">Bestiaire</p><h2 id="sacred-animals-title" class="mt-1 font-mythic text-2xl text-celestial-800 sm:text-3xl">Animaux sacrés</h2></div><span class="text-xs text-slate-400">{{ animaux|length }}</span></div><div class="mt-6 grid gap-5 min-[494px]:grid-cols-2 lg:grid-cols-3">{% for animal in animaux %}{% include 'public/content/_relic_card.html.twig' with {item: animal, categoryLabel: 'Animal sacré', imageDirectory: 'uploads/animaux/', detailRoute: 'app_public_animal_show'} only %}{% else %}<p class="col-span-full py-10 text-center text-slate-500">Aucun animal sacré n’est disponible.</p>{% endfor %}</div></section>
{% endblock %}
