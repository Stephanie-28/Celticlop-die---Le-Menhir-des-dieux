{% extends 'public/content/_layout.html.twig' %}
{% block title %}{{ item.name }} — {{ categoryLabel }}{% endblock %}
{% block content %}
    {% if is_granted('ROLE_ADMIN') %}<div class="mb-5 flex justify-end">{% include 'admin/_partials/_edit_pencil.html.twig' with {contentType: '', contentName: item.name, editUrl: path(adminEditRoute, {id: item.id})} only %}</div>{% endif %}
    <article class="mx-auto max-w-4xl overflow-hidden rounded-[1.75rem] bg-white shadow-[0_12px_35px_rgba(30,58,49,0.1)]">{% if item.img %}<div class="w-full overflow-hidden bg-[#f1f5f4]"><img src="{{ asset(imageDirectory ~ item.img) }}" alt="{{ item.name }}" class="block h-auto w-full object-contain object-center"></div>{% endif %}<div class="px-6 py-8 sm:px-10 sm:py-10"><p class="text-[10px] font-semibold uppercase tracking-[0.25em] text-mythic-gold">{{ categoryLabel }}</p><h1 class="mt-3 font-mythic text-3xl text-celestial-800 sm:text-4xl">{{ item.name }}</h1><div class="mt-6 whitespace-pre-line text-[15px] leading-8 text-slate-600">{{ item.description }}</div></div></article>
    {% if associatedGods is not empty %}<section class="mx-auto mt-10 max-w-4xl" aria-labelledby="associated-gods-title"><h2 id="associated-gods-title" class="font-mythic text-2xl text-celestial-800">Divinités associées</h2><div class="mt-5 grid gap-5 min-[494px]:grid-cols-2 lg:grid-cols-3">{% for dieu in associatedGods %}{% include '_partials/_public_deity_card.html.twig' with {dieu: dieu} only %}{% endfor %}</div></section>{% endif %}
    <div class="mx-auto mt-9 max-w-4xl"><a href="{{ path('app_public_relique_index') }}" class="inline-flex items-center gap-2 rounded-full border border-mythic-gold/40 bg-white px-5 py-2.5 text-sm font-semibold text-[#8a6a18] transition hover:border-mythic-gold focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-mythic-gold">← Retour aux Reliques Célestes</a></div>
{% endblock %}
