{% extends 'public/content/_layout.html.twig' %}
{% block title %}Chroniques Mythiques — Le Menhir des Dieux{% endblock %}
{% block content %}
    <header class="text-center"><p class="text-[10px] uppercase tracking-[0.3em] text-mythic-gold">Récits des anciens mondes</p><h1 class="mt-3 font-mythic text-3xl text-celestial-800 sm:text-5xl">Chroniques Mythiques</h1><p class="mx-auto mt-4 max-w-2xl text-sm leading-7 text-slate-600">Parcours les chroniques rattachées aux mythes préservés.</p></header>
    <section class="mt-9 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" aria-label="Chroniques disponibles">
        {% for chronique in chroniques %}
            <article class="flex min-h-64 flex-col rounded-3xl border border-[#e5dfcf] bg-white p-6 shadow-[0_8px_24px_rgba(45,70,62,0.08)]">
                <p class="text-[9px] uppercase tracking-[0.18em] text-mythic-gold">{{ chronique.mythe.title }}</p><h2 class="mt-3 font-mythic text-xl text-celestial-800">{{ chronique.title }}</h2><p class="mt-4 line-clamp-5 text-sm leading-6 text-slate-600">{{ chronique.content }}</p><a href="{{ path('app_public_chronique_show', {id: chronique.id}) }}" class="mt-auto pt-6 text-sm font-semibold text-[#8a6a18]">Découvrir la chronique →</a>
            </article>
        {% else %}<p class="col-span-full rounded-3xl bg-white px-6 py-12 text-center text-slate-500">Aucune chronique n’est encore publiée.</p>{% endfor %}
    </section>
{% endblock %}
