{% extends 'public/content/_layout.html.twig' %}
{% block title %}{{ savoir.title }} — Archives du Druide{% endblock %}
{% block content %}
    {% if is_granted('ROLE_ADMIN') %}<div class="mb-5 flex justify-end">{% include 'admin/_partials/_edit_pencil.html.twig' with {contentType: '', contentName: savoir.title, editUrl: path('app_admin_savoir_edit', {id: savoir.id})} only %}</div>{% endif %}
    <article class="overflow-hidden rounded-[1.75rem] bg-white shadow-[0_12px_35px_rgba(30,58,49,0.1)]">
        {% if savoir.img %}<img src="{{ asset('uploads/savoirs/' ~ savoir.img) }}" alt="Illustration de {{ savoir.title }}" class="h-auto w-full bg-[#eee8d9] object-contain object-center">{% endif %}
        <div class="border-b border-[#eee6d1] px-6 py-8 sm:px-10"><p class="text-[10px] uppercase tracking-[0.25em] text-mythic-gold">{{ savoir.editorialType.label }}</p><h1 class="mt-3 font-mythic text-3xl text-celestial-800 sm:text-4xl">{{ savoir.title }}</h1><p class="mt-4 max-w-3xl text-base leading-7 text-slate-600">{{ savoir.summary }}</p><time class="mt-3 block text-xs text-slate-400">{{ savoir.createdAt|date('d/m/Y') }}</time></div>
        {% if savoir.content and savoir.content != savoir.summary %}
            <div class="whitespace-pre-line px-6 py-8 text-[15px] leading-8 text-slate-600 sm:px-10">{{ savoir.content }}</div>
        {% else %}
            <p class="px-6 py-8 text-sm italic leading-7 text-slate-500 sm:px-10">Le corpus disponible contient actuellement le résumé présenté ci-dessus.</p>
        {% endif %}
    </article>
    <a href="{{ path('app_public_savoir_index') }}" class="mt-7 inline-flex text-sm font-semibold text-[#8a6a18]">← Retour aux Archives</a>
{% endblock %}
