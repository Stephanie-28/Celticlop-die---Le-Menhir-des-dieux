{% extends 'public/content/_layout.html.twig' %}
{% block title %}Bibliothèque des Savoirs — Le Menhir des Dieux{% endblock %}
{% block content %}
    <header class="rounded-[1.75rem] bg-[#173d34] px-6 py-9 text-center text-white shadow-xl sm:px-10">
        <p class="text-[10px] uppercase tracking-[0.3em] text-[#e2c15f]">Archives du Druide</p>
        <h1 class="mt-3 font-mythic text-3xl sm:text-4xl">Tous les Savoirs Préservés</h1>
        <p class="mx-auto mt-4 max-w-2xl text-sm leading-7 text-white/75">Les 37 entrées du corpus éditorial sécurisé.</p>
    </header>
    {% set groups = [
        {title: 'Savoirs officiels', label: '12 études', items: officialSavoirs},
        {title: 'Découvertes documentaires', label: '20 découvertes', items: discoveries},
        {title: 'Dossiers des Archives', label: '5 dossiers', items: dossiers}
    ] %}
    {% for group in groups %}
        <section class="mt-10" aria-labelledby="library-group-{{ loop.index }}">
            <p class="text-[10px] uppercase tracking-[0.22em] text-mythic-gold">{{ group.label }}</p>
            <h2 id="library-group-{{ loop.index }}" class="mt-1 font-mythic text-2xl text-celestial-800">{{ group.title }}</h2>
            <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {% for savoir in group.items %}
                    <article class="flex flex-col rounded-3xl border border-[#e4ddc8] bg-white p-6 shadow-[0_8px_25px_rgba(30,58,49,0.07)]">
                        {% if savoir.isFocus %}<span class="text-[9px] font-semibold uppercase tracking-[0.2em] text-mythic-gold">Focus du mois</span>{% endif %}
                        <h3 class="mt-2 font-mythic text-lg text-celestial-800">{{ savoir.title }}</h3>
                        <p class="mt-3 line-clamp-4 text-sm leading-6 text-slate-600">{{ savoir.summary }}</p>
                        <a href="{{ path('app_public_savoir_show', {id: savoir.id}) }}" class="mt-auto pt-5 text-sm font-semibold text-[#8a6a18]">Lire l’archive →</a>
                    </article>
                {% endfor %}
            </div>
        </section>
    {% endfor %}
    <a href="{{ path('app_public_savoir_index') }}" class="mt-10 inline-flex text-sm font-semibold text-[#8a6a18]">← Retour aux Archives</a>
{% endblock %}
