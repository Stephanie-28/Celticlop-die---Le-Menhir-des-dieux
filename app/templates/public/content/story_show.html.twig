{% extends 'public/content/_layout.html.twig' %}

{% block title %}{{ story.title }} — Chroniques Mythiques{% endblock %}

{% block content %}
    <article class="overflow-hidden rounded-[1.75rem] bg-white shadow-[0_12px_35px_rgba(30,58,49,0.1)]">
        {% if story.image %}
            <div class="relative">
                <img src="{{ asset(story.image) }}" alt="{{ story.imageAlt }}" class="block h-auto w-full object-contain object-center">
                <div class="absolute inset-0 bg-gradient-to-t from-[#102f28]/80 via-transparent to-transparent"></div>
                <div class="absolute inset-x-0 bottom-0 px-6 pb-7 text-white sm:px-11 sm:pb-10">
                    <p class="text-[10px] uppercase tracking-[0.25em] text-[#f3d77d]">{{ story.eyebrow }}</p>
                    <h1 class="mt-3 max-w-3xl font-mythic text-3xl leading-tight sm:text-5xl">{{ story.title }}</h1>
                </div>
            </div>
        {% else %}
            <header class="bg-[#f3f8fc] px-6 py-12 text-center sm:px-11 sm:py-16">
                <p class="text-[10px] uppercase tracking-[0.25em] text-mythic-gold">{{ story.eyebrow }}</p>
                <h1 class="mt-3 font-mythic text-3xl leading-tight text-celestial-800 sm:text-5xl">{{ story.title }}</h1>
                <p class="mt-5 text-sm text-slate-500">Image indisponible</p>
            </header>
        {% endif %}

        <div class="px-6 py-9 sm:px-11 sm:py-12">
            <p class="max-w-3xl text-lg italic leading-8 text-celestial-800">{{ story.summary }}</p>
            <div aria-hidden="true" class="my-8 flex items-center gap-3 text-mythic-gold">
                <span class="h-px flex-1 bg-mythic-gold/30"></span><span>◇</span><span class="h-px flex-1 bg-mythic-gold/30"></span>
            </div>
            <div class="mx-auto max-w-3xl space-y-6 text-[15px] leading-8 text-slate-700 sm:text-base">
                {% for paragraph in story.content %}
                    <p>{{ paragraph }}</p>
                {% endfor %}
            </div>
        </div>
    </article>

    <a href="{{ path('app_public_chronique_index') }}" class="mt-7 inline-flex items-center gap-2 text-sm font-semibold text-[#8a6a18]">← Retour aux Chroniques Mythiques</a>
{% endblock %}
