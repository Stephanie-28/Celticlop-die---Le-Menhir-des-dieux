{% extends 'public/content/_layout.html.twig' %}
{% block title %}Archives du Druide — Le Menhir des Dieux{% endblock %}
{% block content %}
    <header class="overflow-hidden rounded-[1.75rem] bg-[#173d34] px-6 py-10 text-center text-white shadow-xl sm:px-10 sm:py-14">
        <p class="text-[10px] uppercase tracking-[0.3em] text-[#e2c15f]">Le sanctuaire de la mémoire</p>
        <h1 class="mt-3 font-mythic text-3xl sm:text-5xl">Archives du Druide</h1>
        <p class="mx-auto mt-4 max-w-2xl text-sm leading-7 text-white/75">Explore les connaissances conservées par les gardiens de Celticlopédie.</p>
    </header>

    {% if is_granted('ROLE_ADMIN') %}
        <nav class="mt-5 flex flex-wrap justify-end gap-3" aria-label="Administration des Archives">
            <a href="{{ path('app_admin_savoir_index') }}" class="rounded-full border border-mythic-gold/40 bg-white px-4 py-2 text-xs font-semibold text-[#765916]">Gérer les Savoirs</a>
            <a href="{{ path('app_admin_savoir_new') }}" class="rounded-full bg-[#173d34] px-4 py-2 text-xs font-semibold text-[#f1d67c]">Confier un Savoir</a>
        </nav>
    {% endif %}

    <section class="mt-10" aria-labelledby="preserved-knowledge-title">
        <div class="flex items-end justify-between gap-4">
            <div><p class="text-[10px] uppercase tracking-[0.25em] text-mythic-gold">Bibliothèque initiatique</p><h2 id="preserved-knowledge-title" class="mt-1 font-mythic text-2xl text-celestial-800 sm:text-3xl">Savoirs Préservés</h2></div>
            <a href="{{ path('app_public_savoir_library') }}" class="shrink-0 text-sm font-semibold text-[#8a6a18] underline decoration-mythic-gold/50 underline-offset-4 focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-mythic-gold">Tout voir</a>
        </div>
        <div class="mt-5 flex snap-x snap-mandatory gap-4 overflow-x-auto overscroll-x-contain pb-4" aria-label="Dossiers principaux">
            {% for savoir in dossiers %}
                <article class="flex min-h-64 basis-[84%] shrink-0 snap-start flex-col rounded-3xl border border-[#e4ddc8] bg-[#fffdf7] p-6 shadow-[0_8px_25px_rgba(30,58,49,0.08)] min-[494px]:basis-[46%] lg:basis-[31%]">
                    <span class="text-[9px] font-semibold uppercase tracking-[0.2em] text-mythic-gold">Dossier des Archives</span>
                    <h3 class="mt-3 font-mythic text-xl text-celestial-800">{{ savoir.title }}</h3>
                    <p class="mt-3 line-clamp-5 text-sm leading-6 text-slate-600">{{ savoir.summary }}</p>
                    <a href="{{ path('app_public_savoir_show', {id: savoir.id}) }}" class="mt-auto pt-5 text-sm font-semibold text-[#8a6a18]">Ouvrir le dossier →</a>
                </article>
            {% endfor %}
        </div>
    </section>

    {% if focus %}
        <section class="mt-8 overflow-hidden rounded-[1.75rem] border border-mythic-gold/30 bg-[#fffaf0] p-7 shadow-[0_12px_32px_rgba(30,58,49,0.08)] sm:p-10" aria-labelledby="focus-title">
            <p class="text-[10px] font-semibold uppercase tracking-[0.25em] text-mythic-gold">Focus du mois</p>
            <h2 id="focus-title" class="mt-3 font-mythic text-2xl text-celestial-800 sm:text-3xl">{{ focus.title }}</h2>
            <p class="mt-4 max-w-3xl text-sm leading-7 text-slate-600">{{ focus.summary }}</p>
            <a href="{{ path('app_public_savoir_show', {id: focus.id}) }}" class="mt-6 inline-flex rounded-full bg-[#173d34] px-5 py-2.5 text-sm font-semibold text-[#f1d67c]">Consulter ce savoir</a>
        </section>
    {% endif %}

    <blockquote class="mx-auto my-10 max-w-3xl border-l-2 border-mythic-gold px-6 py-2 text-center text-base italic leading-8 text-celestial-800 sm:text-lg">« La vraie sagesse commence quand on accepte de ne pas savoir. »</blockquote>
    <p class="mx-auto max-w-3xl text-center text-sm leading-7 text-slate-600">Les Archives rassemblent les savoirs officiels, les découvertes documentaires et les dossiers préservés du Menhir. Chaque entrée ouvre le contenu réellement disponible dans le corpus.</p>
{% endblock %}
