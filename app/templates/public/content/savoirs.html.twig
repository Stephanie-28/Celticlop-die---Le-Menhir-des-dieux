{% extends 'public/content/_layout.html.twig' %}
{% block title %}Archives du Druide — Le Menhir des Dieux{% endblock %}
{% block content %}
    <header class="rounded-[1.75rem] bg-[#173d34] px-6 py-10 text-center text-white shadow-xl sm:px-10 sm:py-14">
        <p class="text-[10px] uppercase tracking-[0.3em] text-[#e2c15f]">Savoirs préservés</p>
        <h1 class="mt-3 font-mythic text-3xl sm:text-5xl">Archives du Druide</h1>
        <p class="mx-auto mt-4 max-w-2xl text-sm leading-7 text-white/75">Explore les connaissances conservées par les gardiens de Celticlopédie.</p>
    </header>
    {% if is_granted('ROLE_ADMIN') %}
        <nav class="mt-5 flex flex-wrap justify-end gap-3" aria-label="Administration des Archives">
            <a href="{{ path('app_admin_savoir_index') }}" class="rounded-full border border-mythic-gold/40 bg-white px-4 py-2 text-xs font-semibold text-[#765916] transition hover:border-mythic-gold hover:bg-[#fffbef] focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-mythic-gold">Gérer les Savoirs</a>
            <a href="{{ path('app_admin_savoir_new') }}" class="rounded-full bg-[#173d34] px-4 py-2 text-xs font-semibold text-[#f1d67c] transition hover:bg-[#225648] focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-mythic-gold">Confier un Savoir</a>
        </nav>
    {% endif %}
    <section class="mt-7 grid gap-5 sm:grid-cols-2" aria-label="Savoirs disponibles">
        {% for savoir in savoirs %}
            <article class="relative overflow-hidden rounded-3xl border border-[#e4ddc8] bg-[#fffdf7] shadow-[0_8px_25px_rgba(30,58,49,0.08)]">
                {% if savoir.img %}<img src="{{ asset('uploads/savoirs/' ~ savoir.img) }}" alt="Illustration de {{ savoir.title }}" class="aspect-[16/9] w-full bg-[#eee8d9] object-cover object-center">{% endif %}
                <div class="p-6 sm:p-7">
                    {% if savoir.isFocus %}<span class="text-[9px] font-semibold uppercase tracking-[0.2em] text-mythic-gold">À la une</span>{% endif %}
                    <h2 class="mt-2 font-mythic text-xl text-celestial-800">{{ savoir.title }}</h2>
                    <p class="mt-3 line-clamp-4 text-sm leading-6 text-slate-600">{{ savoir.content }}</p>
                    <div class="mt-5 flex items-center justify-between gap-3"><time class="text-[10px] text-slate-400" datetime="{{ savoir.createdAt|date('Y-m-d') }}">{{ savoir.createdAt|date('d/m/Y') }}</time><a href="{{ path('app_public_savoir_show', {id: savoir.id}) }}" class="rounded text-sm font-semibold text-[#8a6a18] underline decoration-mythic-gold/50 underline-offset-4 transition hover:text-[#173d34] focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-mythic-gold">Lire l’archive</a></div>
                </div>
            </article>
        {% else %}
            <div class="relative col-span-full overflow-hidden rounded-[2rem] border border-mythic-gold/30 bg-[#fffaf0] px-6 py-14 text-center shadow-[0_12px_32px_rgba(30,58,49,0.08)] sm:px-12 sm:py-16">
                <div class="pointer-events-none absolute inset-4 rounded-[1.5rem] border border-[#d8c792]/35" aria-hidden="true"></div>
                <div class="relative mx-auto flex size-20 items-center justify-center rounded-full border border-mythic-gold/40 bg-white text-mythic-gold shadow-sm" aria-hidden="true">
                    <svg viewBox="0 0 64 64" fill="none" class="size-11"><path d="M13 15.5c8-3 14.5-1.7 19 2.5v32c-4.5-4.2-11-5.5-19-2.5v-32Zm38 0c-8-3-14.5-1.7-19 2.5v32c4.5-4.2 11-5.5 19-2.5v-32Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M18 23c4.8-1.2 8.4-.4 11 1.8M18 30c4.8-1.2 8.4-.4 11 1.8M46 23c-4.8-1.2-8.4-.4-11 1.8M46 30c-4.8-1.2-8.4-.4-11 1.8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                </div>
                <p class="relative mt-6 text-[10px] font-semibold uppercase tracking-[0.28em] text-mythic-gold">La bibliothèque demeure ouverte</p>
                <h2 class="relative mx-auto mt-3 max-w-xl font-mythic text-2xl leading-relaxed text-celestial-800 sm:text-3xl">Les Archives attendent encore les premiers savoirs confiés au Menhir.</h2>
                <p class="relative mx-auto mt-4 max-w-lg text-sm leading-7 text-slate-600">Lorsque le Grand Druide préservera un premier manuscrit, il prendra place ici sans qu’aucun récit fictif ne soit ajouté.</p>
            </div>
        {% endfor %}
    </section>
{% endblock %}
