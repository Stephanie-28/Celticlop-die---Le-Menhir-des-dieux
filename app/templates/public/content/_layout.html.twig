{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Metamorphous&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <style type="text/tailwindcss">@theme { --font-mythic: "Metamorphous", serif; --font-editorial: "Lora", serif; --color-mythic-gold: #d3aa32; --color-forest-900: #173d34; --color-celestial-800: #34576d; }</style>
{% endblock %}

{% block body %}
    {% include '_partials/_header.html.twig' %}
    <main class="min-h-screen bg-[#f5f7f6] px-3 pb-28 pt-7 font-editorial text-forest-900 sm:px-6 sm:pt-10">
        <div class="mx-auto max-w-5xl">
            {% block content %}{% endblock %}
        </div>
    </main>
    {% include '_partials/_bottom_nav.html.twig' %}
{% endblock %}
