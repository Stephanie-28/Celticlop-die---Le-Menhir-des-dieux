{% extends 'public/content/_layout.html.twig' %}

{% block title %}Accessibilité (RGAA) — Le Menhir des Dieux{% endblock %}

{% block content %}
    <a href="{{ path('app_profile_settings') }}" class="text-sm font-semibold text-[#8a6a18]">← Retour aux paramètres du clan</a>
    <header class="mx-auto mt-7 max-w-2xl text-center">
        <h1 class="font-mythic text-3xl text-celestial-800 sm:text-5xl">Accessibilité (RGAA)</h1>
        <p class="mt-4 text-sm leading-7 text-slate-600">Déclaration d’accessibilité du site Le Menhir des Dieux.</p>
    </header>
    <div class="mx-auto mt-9 grid max-w-3xl gap-5">
        <section class="rounded-2xl bg-white p-6 shadow-sm"><h2 class="font-mythic text-lg text-celestial-800">État de conformité</h2><p class="mt-3 text-sm leading-7 text-slate-600">Le site est déclaré non conforme tant qu’un audit RGAA exhaustif n’a pas établi son niveau de conformité.</p></section>
        <section class="rounded-2xl bg-white p-6 shadow-sm"><h2 class="font-mythic text-lg text-celestial-800">Contrôles réalisés</h2><ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-7 text-slate-600"><li>navigation au clavier et focus visible ;</li><li>structure sémantique et libellés accessibles ;</li><li>alternatives textuelles des images.</li></ul></section>
        <section class="rounded-2xl bg-white p-6 shadow-sm"><h2 class="font-mythic text-lg text-celestial-800">Signaler un obstacle</h2><p class="mt-3 text-sm leading-7 text-slate-600">Indiquez la page concernée, l’action souhaitée et la technologie d’assistance utilisée.</p></section>
    </div>
{% endblock %}
