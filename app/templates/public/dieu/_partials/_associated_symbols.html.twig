<section class="py-3" aria-labelledby="associated-symbols-title">
    <h2 id="associated-symbols-title" class="font-mythic text-xl uppercase text-celestial-800">Symboles associés</h2>

    <div class="mt-5 grid gap-5 sm:grid-cols-2">
        {% for symbole in symboles %}
            <a href="{{ path('app_public_symbole_show', {id: symbole.id}) }}" class="group overflow-hidden rounded-2xl bg-white shadow-[0_8px_24px_rgba(52,87,109,0.08)] transition duration-200 hover:-translate-y-0.5 hover:shadow-[0_12px_30px_rgba(52,87,109,0.12)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-celestial-800">
                {% if symbole.img %}
                    <img src="{{ asset('uploads/symboles/' ~ symbole.img) }}" alt="{{ symbole.name }}" class="aspect-[3/2] w-full object-cover object-center">
                {% endif %}
                <div class="p-5">
                    <h3 class="font-mythic text-sm uppercase text-celestial-800 transition group-hover:text-mythic-gold">{{ symbole.name }}</h3>
                    {% if symbole.description %}
                        <p class="mt-2 line-clamp-3 text-xs leading-5 text-slate-600">{{ symbole.description }}</p>
                    {% endif %}
                </div>
            </a>
        {% endfor %}
    </div>
</section>
