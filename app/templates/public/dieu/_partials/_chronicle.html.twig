<section class="rounded-3xl bg-white px-5 py-7 shadow-[0_8px_24px_rgba(52,87,109,0.08)] sm:px-8" aria-labelledby="chroniques-title">
    <h2 id="chroniques-title" class="flex items-center gap-2 font-mythic text-lg uppercase tracking-wide text-mythic-gold sm:text-xl">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="size-5 shrink-0" xmlns="http://www.w3.org/2000/svg">
            <path d="M5 5.5C7.5 4.8 9.7 5.2 12 6.7V19C9.7 17.5 7.5 17.1 5 17.8V5.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
            <path d="M19 5.5C16.5 4.8 14.3 5.2 12 6.7V19C14.3 17.5 16.5 17.1 19 17.8V5.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
        </svg>
        Chroniques sacrées
    </h2>

    <div class="mt-5 space-y-5 text-[14px] leading-7 text-slate-600 sm:text-[15px]">
        {% set chronicleParagraphs = paragraphs is not empty ? paragraphs : description|split("\n\n") %}
        {% set highlightAfter = chronicleParagraphs|length >= 3 ? 3 : chronicleParagraphs|length %}
        {% for paragraph in chronicleParagraphs %}
            {% if paragraph|trim is not empty %}
                <p>{{ paragraph|trim }}</p>
            {% endif %}
            {% if highlight and loop.index == highlightAfter %}
                <blockquote class="my-7 border-l-2 border-mythic-gold pl-5 italic text-celestial-800 sm:my-8 sm:pl-6">
                    {{ highlight }}
                </blockquote>
            {% endif %}
        {% endfor %}
    </div>
</section>
