<section class="overflow-hidden bg-white shadow-[0_8px_24px_rgba(52,87,109,0.08)] sm:mt-8 sm:rounded-3xl" aria-labelledby="deity-title">
    {% if dieu.img %}
        <div class="relative mx-auto aspect-[2/3] w-full max-w-[560px] overflow-hidden bg-celestial-50">
            <img
                src="{% include '_partials/_deity_portrait_src.html.twig' with {dieu: dieu} only %}"
                alt="Portrait de {{ dieu.name }}"
                class="h-full w-full object-contain object-center"
            >

            {% if dieu.quote is not empty %}
                <div class="absolute right-[3%] bottom-[5%] z-10 flex w-fit max-w-[64%] items-center justify-center rounded-[50%] border-2 border-mythic-gold/55 bg-white/85 px-5 py-5 shadow-[0_3px_10px_rgba(52,87,109,0.08)] backdrop-blur-[1px] sm:px-6 sm:py-6">
                    <p class="text-center text-[14px] leading-relaxed italic text-celestial-800 sm:text-[15px]">« {{ dieu.quote }} »</p>
                </div>
            {% endif %}
        </div>
    {% endif %}

    <div class="px-5 py-7 sm:px-9 sm:py-9">
        {% if dieu.pantheons is not empty %}
            <span class="inline-flex rounded-full bg-celestial-100 px-3 py-1 text-[9px] font-semibold uppercase tracking-[0.16em] text-celestial-600">{{ (dieu.pantheons|first).title }}</span>
        {% endif %}
        <h1 id="deity-title" class="mt-3 font-mythic text-3xl uppercase text-celestial-800 sm:text-4xl">{{ dieu.name }}</h1>
        <p class="mt-2 text-sm italic text-mythic-gold sm:text-base">{{ dieu.title }}</p>
    </div>
</section>
