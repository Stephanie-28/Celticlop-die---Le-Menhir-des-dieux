{% set heroTitleId = titleId|default('deity-title') %}
{% set heroName = displayName|default(dieu.name) %}
{% set heroBadge = badge|default(dieu.pantheons is not empty ? (dieu.pantheons|first).title : null) %}

<section class="overflow-hidden bg-white shadow-[0_8px_24px_rgba(52,87,109,0.08)] sm:mt-8 sm:rounded-3xl" aria-labelledby="{{ heroTitleId }}">
    {% if dieu.img %}
        <div class="relative w-full overflow-hidden bg-celestial-50">
            <img
                src="{% include '_partials/_deity_portrait_src.html.twig' with {dieu: dieu} only %}"
                alt="Portrait de {{ dieu.name }}"
                class="block h-auto w-full object-contain object-center"
            >

            {% if dieu.quote is not empty %}
                <div class="absolute right-[3%] bottom-[5%] z-10 flex w-fit max-w-[62%] items-center justify-center rounded-[50%] border-2 border-mythic-gold/55 bg-white/85 px-5 py-5 shadow-[0_3px_10px_rgba(52,87,109,0.08)] backdrop-blur-[1px] sm:px-6 sm:py-6">
                    <p class="relative text-center font-editorial text-[14px] leading-relaxed italic text-celestial-800 sm:text-[15px]">« {{ dieu.quote }} »</p>
                </div>
            {% endif %}
        </div>
    {% endif %}

    <div class="px-5 py-7 sm:px-9 sm:py-9">
        {% if heroBadge %}
            <span class="inline-flex rounded-full bg-celestial-100 px-3 py-1 text-[9px] font-semibold uppercase tracking-[0.16em] text-celestial-600">{{ heroBadge }}</span>
        {% endif %}
        <h1 id="{{ heroTitleId }}" class="mt-3 font-mythic text-3xl uppercase text-celestial-800 sm:text-4xl">{{ heroName }}</h1>
        <p class="mt-2 text-sm italic text-mythic-gold sm:text-base">{{ dieu.title }}</p>
    </div>
</section>
