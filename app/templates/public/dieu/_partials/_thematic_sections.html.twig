{% for section in sections %}
    <section class="rounded-3xl bg-white px-6 py-8 text-center shadow-[0_8px_24px_rgba(52,87,109,0.08)] sm:px-8 sm:py-9" aria-labelledby="thematic-section-{{ loop.index }}">
        <svg aria-hidden="true" viewBox="0 0 48 48" fill="none" class="mx-auto size-10 text-mythic-gold" xmlns="http://www.w3.org/2000/svg">
            <path d="M24 6L28 17L40 18L31 26L34 38L24 31L14 38L17 26L8 18L20 17L24 6Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
        </svg>
        <p class="mt-3 text-[10px] font-semibold uppercase tracking-[0.18em] text-mythic-gold">{{ section.eyebrow }}</p>
        <h2 id="thematic-section-{{ loop.index }}" class="mt-2 font-mythic text-lg uppercase text-celestial-800">{{ section.title }}</h2>
        <p class="mx-auto mt-3 max-w-md text-sm leading-6 text-slate-600">{{ section.description }}</p>
    </section>
{% endfor %}
