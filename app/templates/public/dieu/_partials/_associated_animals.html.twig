<section class="py-3" aria-labelledby="associated-animals-title">
    <h2 id="associated-animals-title" class="font-mythic text-xl uppercase text-celestial-800">Animaux associés</h2>

    <div class="-mx-3 mt-5 flex snap-x snap-mandatory gap-4 overflow-x-auto px-3 pb-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
        {% for animal in animaux %}
            <a href="{{ path('app_public_animal_show', {id: animal.id}) }}" class="group w-[72%] max-w-[250px] shrink-0 snap-start overflow-hidden rounded-2xl bg-white shadow-[0_8px_24px_rgba(52,87,109,0.08)] transition duration-200 hover:-translate-y-0.5 hover:shadow-[0_12px_30px_rgba(52,87,109,0.12)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-celestial-800 sm:w-[230px]">
                {% if animal.img %}
                    <img src="{{ asset('uploads/animaux/' ~ animal.img) }}" alt="{{ animal.name }}" class="aspect-[4/3] w-full object-cover object-center">
                {% endif %}
                <div class="p-4">
                    <h3 class="font-mythic text-sm uppercase text-celestial-800 transition group-hover:text-mythic-gold">{{ animal.name }}</h3>
                    {% if animal.description %}
                        <p class="mt-2 line-clamp-3 text-xs leading-5 text-slate-600">{{ animal.description }}</p>
                    {% endif %}
                </div>
            </a>
        {% endfor %}
    </div>
</section>
