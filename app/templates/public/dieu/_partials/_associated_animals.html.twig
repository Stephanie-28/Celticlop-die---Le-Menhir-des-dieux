{% for animal in animaux %}
    {% set associationContext = contexts[animal.id]|default('Animal associé') %}
    <a
        href="{{ path('app_public_animal_show', {id: animal.id}) }}"
        class="group block overflow-hidden rounded-3xl bg-white shadow-[0_8px_24px_rgba(52,87,109,0.08)] transition duration-200 hover:-translate-y-0.5 hover:shadow-[0_12px_30px_rgba(52,87,109,0.12)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-celestial-800"
        aria-label="Découvrir {{ animal.name }}"
    >
        {% if animal.img %}
            <img
                src="{{ asset('uploads/animaux/' ~ animal.img) }}"
                alt="{{ animal.name }} — {{ associationContext|lower }} de cette divinité"
                class="aspect-[16/9] w-full object-cover object-center"
            >
        {% endif %}
        <div class="px-6 py-7 sm:px-8 sm:py-8">
            <p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-mythic-gold">{{ associationContext }}</p>
            <h2 class="mt-2 font-mythic text-xl uppercase text-celestial-800 sm:text-2xl">{{ animal.name }}</h2>
            {% if animal.description %}
                <p class="mt-3 text-sm leading-6 text-slate-600">{{ animal.description }}</p>
            {% endif %}
        </div>
    </a>
{% endfor %}
