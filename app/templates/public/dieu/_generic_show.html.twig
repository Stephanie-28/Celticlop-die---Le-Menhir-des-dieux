<main class="min-h-screen overflow-x-hidden bg-[#f7fafc] pb-28 font-editorial text-celestial-800">
    <article class="mx-auto max-w-3xl">
        {% include 'public/dieu/_partials/_hero.html.twig' with {dieu: dieu} only %}

        <div class="space-y-5 px-3 py-5 sm:px-0 sm:py-7">
            {% if dieu.description is not empty %}
                <section class="rounded-3xl bg-white px-5 py-7 shadow-[0_8px_24px_rgba(52,87,109,0.08)] sm:px-8" aria-labelledby="presentation-title">
                    <h2 id="presentation-title" class="font-mythic text-lg uppercase tracking-wide text-mythic-gold sm:text-xl">Présentation</h2>
                    <div class="mt-5 whitespace-pre-line text-[14px] leading-7 text-slate-600 sm:text-[15px]">{{ dieu.description }}</div>
                </section>
            {% endif %}

            {% if not app.user %}
                {% include 'public/dieu/_partials/_login_teaser.html.twig' only %}
            {% endif %}

            {% if app.user %}
                {% if dieu.symboles is not empty %}
                    {% include 'public/dieu/_partials/_associated_symbols.html.twig' with {symboles: dieu.symboles} only %}
                {% endif %}

                {% if dieu.animaux is not empty %}
                    {% include 'public/dieu/_partials/_associated_animals.html.twig' with {animaux: dieu.animaux} only %}
                {% endif %}
            {% endif %}

            <nav class="flex items-center px-2 py-4" aria-label="Navigation de l’encyclopédie">
                <a href="{{ path('app_public_pantheon_all') }}" class="inline-flex min-h-11 items-center gap-2 rounded-full text-xs uppercase tracking-wider text-mythic-gold transition hover:text-celestial-800 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-celestial-800">
                    <span aria-hidden="true">←</span>
                    Retour aux divinités
                </a>
            </nav>
        </div>
    </article>
</main>
