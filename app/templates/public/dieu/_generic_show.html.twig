{% include 'public/dieu/_partials/_encyclopedia_start.html.twig' with {
    dieu: dieu,
    publicDescription: unifiedContext.publicDescription
} only %}

            {% if app.user %}
                {% if dieu.description is not empty %}
                    {% include 'public/dieu/_partials/_chronicle.html.twig' with {
                        description: dieu.description,
                        highlight: unifiedContext.chronicleHighlight,
                        paragraphs: unifiedContext.chronicleParagraphs
                    } only %}
                {% endif %}

                {% if unifiedContext.thematicSections is not empty %}
                    {% include 'public/dieu/_partials/_thematic_sections.html.twig' with {sections: unifiedContext.thematicSections} only %}
                {% endif %}

                {% if unifiedContext.displaySymbols is not empty %}
                    {% include 'public/dieu/_partials/_associated_symbols.html.twig' with {symboles: unifiedContext.displaySymbols} only %}
                {% endif %}

                {% if unifiedContext.displayAnimals is not empty %}
                    {% include 'public/dieu/_partials/_associated_animals.html.twig' with {
                        animaux: unifiedContext.displayAnimals,
                        contexts: unifiedContext.animalContexts
                    } only %}
                {% endif %}

                {% if unifiedContext.editorialAttributes is not empty %}
                    {% include 'public/dieu/_partials/_editorial_attributes.html.twig' with {attributes: unifiedContext.editorialAttributes} only %}
                {% endif %}

                {% if unifiedContext.genealogy is not empty %}
                    {% include 'public/dieu/_partials/_genealogy.html.twig' with {genealogy: unifiedContext.genealogy} only %}
                {% endif %}

                {% if unifiedContext.associatedDeities is not empty %}
                    {% include 'public/dieu/_partials/_associated_deities.html.twig' with {
                        associations: unifiedContext.associatedDeities,
                        pantheonTitle: unifiedContext.pantheonTitle
                    } only %}
                {% endif %}
            {% endif %}

{% include 'public/dieu/_partials/_encyclopedia_end.html.twig' with {
    nextDieu: unifiedContext.nextDieu,
    returnRoute: 'app_public_pantheon_all'
} only %}
