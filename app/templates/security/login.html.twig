{% extends 'auth_base.html.twig' %}

{% block title %}Connexion — Le Menhir des Dieux{% endblock %}

{% block auth_title %}Connexion<br>au Clan{% endblock %}

{% block auth_intro %}Arriver de l’Initié{% endblock %}

{% block auth_form %}
    {% if error %}
        <div class="mb-5 rounded-xl bg-red-50 px-4 py-3 text-sm text-red-700" role="alert">
            Identifiants incorrects. Vérifiez votre email et votre sceau de sécurité.
        </div>
    {% endif %}

    <form method="post" class="auth-form">
        <div>
            <label for="username" class="auth-label">
                <svg aria-hidden="true" viewBox="0 0 24 24" class="auth-label-icon fill-current"><circle cx="12" cy="7.5" r="4"/><path d="M5.5 21v-3.3A6.5 6.5 0 0 1 12 11.2a6.5 6.5 0 0 1 6.5 6.5V21Z"/></svg>
                Nom d’Initié
            </label>
            <input type="email" value="{{ last_username }}" name="_username" id="username" autocomplete="email" required autofocus class="auth-field">
        </div>

        <div>
            <label for="password" class="auth-label">
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="auth-label-icon"><rect x="5.5" y="10" width="13" height="11" rx="1.5" stroke="currentColor" stroke-width="1.7"/><path d="M8.5 10V7a3.5 3.5 0 0 1 7 0v3M12 14.5v3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                Sceau de Sécurité
            </label>
            <div class="relative">
                <input type="password" name="_password" id="password" autocomplete="current-password" required class="auth-field pr-11">
                <button type="button" data-password-toggle="password" aria-label="Afficher ou masquer le mot de passe" aria-pressed="false" class="absolute inset-y-0 right-0 flex w-10 items-center justify-center text-slate-500">
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="size-4" xmlns="http://www.w3.org/2000/svg"><path d="M3.5 12S6.5 7 12 7S20.5 12 20.5 12S17.5 17 12 17S3.5 12 3.5 12Z" stroke="currentColor" stroke-width="1.4"/><circle cx="12" cy="12" r="2.25" stroke="currentColor" stroke-width="1.4"/></svg>
                </button>
            </div>
            <p class="mt-5 text-right text-sm text-sky-600">Sagesse oubliée ?</p>
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <button type="submit" class="auth-submit">
            Entrer dans le Clan&nbsp; ✦
        </button>
    </form>
{% endblock %}

{% block auth_footer %}
    <a href="{{ path('app_register') }}" class="inline-block cursor-pointer text-[#174f7d] transition hover:text-celestial-600">
        Pas encore avec nous ? Rejoindre le Clan !
    </a>
{% endblock %}
