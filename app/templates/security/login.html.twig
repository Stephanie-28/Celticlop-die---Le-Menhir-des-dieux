{% extends 'base.html.twig' %}

{% block title %}Connexion — Le Menhir des Dieux{% endblock %}

{% block stylesheets %}
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
{% endblock %}

{% block body %}
    <main class="flex min-h-screen items-center justify-center bg-slate-50 px-4 py-10 text-slate-800">
        <section class="w-full max-w-sm rounded-2xl bg-white p-7 shadow-lg" aria-labelledby="login-title">
            <h1 id="login-title" class="text-2xl font-semibold">Connexion</h1>

            {% if error %}
                <p class="mt-4 rounded-lg bg-red-50 p-3 text-sm text-red-700" role="alert">Identifiants incorrects.</p>
            {% endif %}

            <form method="post" class="mt-6 space-y-5">
                <div>
                    <label for="username" class="block text-sm font-medium">Adresse email</label>
                    <input id="username" name="_username" type="email" value="{{ last_username }}" autocomplete="email" required autofocus class="mt-2 w-full rounded-lg border border-slate-300 px-3 py-2">
                </div>
                <div>
                    <label for="password" class="block text-sm font-medium">Mot de passe</label>
                    <input id="password" name="_password" type="password" autocomplete="current-password" required class="mt-2 w-full rounded-lg border border-slate-300 px-3 py-2">
                </div>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <button type="submit" class="w-full rounded-full bg-[#d3aa32] px-5 py-3 font-semibold text-white">Se connecter</button>
            </form>
        </section>
    </main>
{% endblock %}
